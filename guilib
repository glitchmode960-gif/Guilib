local THEME_KEYS = { "Background", "Topbar", "Element", "Hover", "Accent", "Stroke" }

-- палитра из одного цвета: тёмные поверхности, тонированные в его оттенок
local function paletteFrom(accent)
	local h, s = Color3.toHSV(accent)
	s = math.clamp(s, 0.35, 0.85)
	return {
		Background = Color3.fromHSV(h, s * 0.75, 0.26),
		Topbar = Color3.fromHSV(h, s * 0.80, 0.19),
		Element = Color3.fromHSV(h, s * 0.85, 0.15),
		Hover = Color3.fromHSV(h, s * 0.70, 0.36),
		Accent = accent,
		Stroke = accent:Lerp(Color3.new(1, 1, 1), 0.12), -- отличается от Accent, чтобы цвета не склеивались
	}
end

local THEMES = {
	Fluent = {
		Background = Color3.fromRGB(14, 58, 68), Topbar = Color3.fromRGB(10, 44, 54),
		Element = Color3.fromRGB(8, 38, 48), Hover = Color3.fromRGB(22, 84, 96),
		Accent = Color3.fromRGB(45, 205, 205), Stroke = Color3.fromRGB(60, 190, 200),
	},
	Delta = {
		Background = Color3.fromRGB(22, 22, 26), Topbar = Color3.fromRGB(28, 28, 34),
		Element = Color3.fromRGB(36, 36, 44), Hover = Color3.fromRGB(48, 48, 58),
		Accent = Color3.fromRGB(0, 170, 255), Stroke = Color3.fromRGB(70, 70, 95),
	},
	Amoled = {
		Background = Color3.fromRGB(0, 0, 0), Topbar = Color3.fromRGB(12, 12, 14),
		Element = Color3.fromRGB(22, 22, 26), Hover = Color3.fromRGB(38, 38, 44),
		Accent = Color3.fromRGB(0, 200, 255), Stroke = Color3.fromRGB(55, 55, 66),
	},
	Midnight = {
		Background = Color3.fromRGB(14, 16, 28), Topbar = Color3.fromRGB(20, 23, 40),
		Element = Color3.fromRGB(28, 32, 54), Hover = Color3.fromRGB(40, 46, 76),
		Accent = Color3.fromRGB(110, 130, 255), Stroke = Color3.fromRGB(90, 105, 210),
	},
}
local THEME_ORDER = { "Fluent", "Delta", "Amoled", "Midnight" }

local ACCENTS = {
	Blue = Color3.fromRGB(70, 120, 255), Red = Color3.fromRGB(235, 70, 90),
	Green = Color3.fromRGB(70, 200, 120), Gold = Color3.fromRGB(230, 180, 60),
	Cyan = Color3.fromRGB(60, 200, 230), Pink = Color3.fromRGB(255, 100, 200),
	Orange = Color3.fromRGB(255, 150, 60), Purple = Color3.fromRGB(140, 90, 255),
	Lime = Color3.fromRGB(170, 230, 60), Rose = Color3.fromRGB(255, 110, 150),
	Mint = Color3.fromRGB(60, 220, 180), Violet = Color3.fromRGB(180, 80, 255),
}
do
	local names = {}
	for name, color in pairs(ACCENTS) do
		THEMES[name] = paletteFrom(color)
		table.insert(names, name)
	end
	table.sort(names)
	for _, n in ipairs(names) do table.insert(THEME_ORDER, n) end
end

local function recolor(root, map)
	for _, obj in ipairs(root:GetDescendants()) do
		if not obj:GetAttribute("NoTheme") then
			pcall(function()
				if obj:IsA("GuiObject") then
					local n = map[hex(obj.BackgroundColor3)]; if n then obj.BackgroundColor3 = n end
				end
				if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
					local n = map[hex(obj.TextColor3)]; if n then obj.TextColor3 = n end
				end
				if obj:IsA("ImageLabel") then
					local n = map[hex(obj.ImageColor3)]; if n then obj.ImageColor3 = n end
				end
				if obj:IsA("ScrollingFrame") then
					local n = map[hex(obj.ScrollBarImageColor3)]; if n then obj.ScrollBarImageColor3 = n end
				end
				if obj:IsA("UIStroke") then
					local n = map[hex(obj.Color)]; if n then obj.Color = n end
				end
				if obj:IsA("UIGradient") then
					local kps, changed = {}, false
					for _, kp in ipairs(obj.Color.Keypoints) do
						local n = map[hex(kp.Value)]
						if n then changed = true end
						table.insert(kps, ColorSequenceKeypoint.new(kp.Time, n or kp.Value))
					end
					if changed then obj.Color = ColorSequence.new(kps) end
				end
			end)
		end
	end
end

-- применяет палитру ко всем открытым окнам и к новым элементам
function Library:ApplyPalette(pal)
	local map = {}
	for _, k in ipairs(THEME_KEYS) do
		local new = pal[k]
		if new and new ~= Theme[k] then map[hex(Theme[k])] = new end
	end
	for _, k in ipairs(THEME_KEYS) do if pal[k] then Theme[k] = pal[k] end end
	for _, w in ipairs(Library._windows) do recolor(w.Gui, map) end
end

function Library:SetTheme(name)
	local pal = THEMES[name]
	if pal then
		Library:ApplyPalette(pal)
		Library._themeName, Library._accent = name, nil
		Library:_prefsChanged()
	end
end

-- своя тема из одного цвета акцента
function Library:SetAccent(color)
	if typeof(color) == "Color3" then
		Library:ApplyPalette(paletteFrom(color))
		Library._themeName, Library._accent = nil, color
		Library:_prefsChanged()
	end
end

function Library:GetThemes()
	return table.clone(THEME_ORDER)
end

function Library:CloseAll()
	for _, w in ipairs(table.clone(Library._windows)) do w:Destroy() end
end

