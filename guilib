function Tab:AddMultiDropdown(o)
	local win = self.Window
	local options = o.Options or {}
	local selected = {}
	for _, v in ipairs(o.Default or {}) do selected[v] = true end
	local open = false
	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(0.5, -16, 1, 0), UDim2.fromOffset(16, 0), 15).Font = Enum.Font.GothamMedium
	local vl = label(row, "0 выбрано", UDim2.new(0.4, -30, 1, 0), UDim2.new(0.5, 0, 0, 0), 14)
	vl.TextXAlignment = Enum.TextXAlignment.Right; vl.TextColor3 = Theme.Accent; vl.Font = Enum.Font.GothamBold
	local header = clickArea(row, ROW)
	local holder = create("Frame", { Position = UDim2.fromOffset(0, ROW), Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1, ClipsDescendants = true, Parent = row })
	create("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = holder })
	local btns = {}
	local function getList()
		local l = {}
		for _, opt in ipairs(options) do if selected[opt] then table.insert(l, opt) end end
		return l
	end
	local function update()
		for _, d in pairs(btns) do
			tween(d.Btn, 0.15, { BackgroundColor3 = selected[d.Name] and Theme.Accent or Theme.Hover })
		end
		vl.Text = #getList() .. " выбрано"
	end
	for _, opt in ipairs(options) do
		local b = create("TextButton", { Size = UDim2.new(1, -16, 0, 40), BackgroundColor3 = Theme.Hover,
			BorderSizePixel = 0, Text = tostring(opt), TextColor3 = Theme.Text,
			Font = Enum.Font.GothamMedium, TextSize = 14, AutoButtonColor = false, Parent = holder }, { corner(10) })
		b.MouseButton1Click:Connect(function()
			selected[opt] = not selected[opt] or nil; update()
			if o.Flag then win.Flags[o.Flag] = getList() end
			safe(o.Callback, getList())
		end)
		btns[opt] = { Name = opt, Btn = b }
	end
	header.MouseButton1Click:Connect(function()
		open = not open
		tween(row, 0.2, { Size = UDim2.new(1, 0, 0, open and (ROW + #options * 46 + 8) or ROW) })
		holder.Size = UDim2.new(1, 0, 0, open and (#options * 46 + 8) or 0)
	end)
	local obj = {}
	function obj:Get() return getList() end
	function obj:Set(list, s)
		selected = {}
		for _, v in ipairs(list) do selected[v] = true end
		update(); if o.Flag then win.Flags[o.Flag] = getList() end
		if not s then safe(o.Callback, getList()) end
	end
	update(); win:_register(o.Flag, obj, getList()); return obj
end

