-- NOTIFY — как в Delta: тёмная карточка
-- ============================================================
function Window:Notify(o)
	if type(o) ~= "table" then o = { Text = tostring(o) } end
	local kind = o.Type or "info"
	local color = Theme[kind:sub(1,1):upper() .. kind:sub(2)] or Theme.Info
	local dur = o.Duration or 4

	local note = create("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 88), BackgroundColor3 = Theme.Topbar,
		BorderSizePixel = 0, GroupTransparency = 1, Parent = self.Notes,
	}, { corner(14) })

	local t = label(note, o.Title or "Notification", UDim2.new(1, -36, 0, 24), UDim2.fromOffset(18, 14), 16)
	t.Font = Enum.Font.GothamBold
	local d = label(note, o.Text or "", UDim2.new(1, -36, 0, 44), UDim2.fromOffset(18, 40), 13)
	d.TextColor3 = Theme.SubText; d.TextWrapped = true; d.TextYAlignment = Enum.TextYAlignment.Top

	local bar = create("Frame", { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = color, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = note }, { corner(2) })
	tween(bar, dur, { Size = UDim2.new(0, 0, 0, 2), BackgroundTransparency = 1 }, Enum.EasingStyle.Linear)

	tween(note, 0.28, { GroupTransparency = 0 }, Enum.EasingStyle.Quint)
	task.delay(dur, function()
		if note.Parent then tween(note, 0.22, { GroupTransparency = 1 }); task.wait(0.25); note:Destroy() end
	end)
end

function Window:NotifyWithButton(cfg)
	cfg = cfg or {}
	local kind = cfg.Type or "info"
	local color = Theme[kind:sub(1,1):upper() .. kind:sub(2)] or Theme.Info
	local note = create("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 108), BackgroundColor3 = Theme.Topbar,
		BorderSizePixel = 0, GroupTransparency = 1, Parent = self.Notes,
	}, { corner(14) })
	local t = label(note, cfg.Title or "Notification", UDim2.new(1, -130, 0, 24), UDim2.fromOffset(18, 14), 16)
	t.Font = Enum.Font.GothamBold
	local d = label(note, cfg.Text or "", UDim2.new(1, -130, 0, 56), UDim2.fromOffset(18, 40), 13)
	d.TextColor3 = Theme.SubText; d.TextWrapped = true; d.TextYAlignment = Enum.TextYAlignment.Top
	local btn = create("TextButton", {
		Size = UDim2.fromOffset(90, 38), Position = UDim2.new(1, -108, 0.5, -19),
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Text = cfg.ButtonText or "OK",
		TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 13,
		AutoButtonColor = false, Parent = note,
	}, { corner(10) })
	btn.MouseButton1Click:Connect(function()
		safe(cfg.ButtonCallback)
		tween(note, 0.2, { GroupTransparency = 1 }); task.delay(0.25, function() note:Destroy() end)
	end)
	tween(note, 0.28, { GroupTransparency = 0 }, Enum.EasingStyle.Quint)
	task.delay(cfg.Duration or 8, function()
		if note.Parent then tween(note, 0.22, { GroupTransparency = 1 }); task.wait(0.25); note:Destroy() end
	end)
end

