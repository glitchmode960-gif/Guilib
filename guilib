	}, { round() })
	local hit = create("TextButton", {
		Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 22),
		BackgroundTransparency = 1, Parent = row,
	})
	attachTip(hit, o.Tooltip)

	local st = { val = value }
	local function render(x)
		vl.Text = string.format(fmt, x) .. (o.Suffix or "")
		fill.Size = UDim2.fromScale((max - min > 0) and (x - min) / (max - min) or 0, 1)
	end
	local obj = {}
	-- animate = true: плавное «докручивание» (программная установка), перетаскивание — мгновенно
	local function set(v, silent, animate)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = math.clamp(math.floor(v * 10000 + 0.5) / 10000, min, max); value = v
		win:_setFlag(o.Flag, v, silent)
		if animate then animNumber(st, v, 0.3, render) else snapNumber(st, v, render) end
		if not silent then safe(o.Callback, v) end
	end
	local function fromInput(i)
		set(min + (max - min) * math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
	end
	-- тач: сначала определяем намерение. Горизонталь — двигаем слайдер, вертикаль — прокручиваем страницу
	local drag, pending, startPos = false, false, nil
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton2 then set(o.Default or min, false, true); return end
		if not isPointer(i) then return end
		if i.UserInputType == Enum.UserInputType.Touch then
			pending, startPos = true, i.Position
		else
			drag = true; scroller.ScrollingEnabled = false; fromInput(i)
		end
	end)
	win:_connect(UIS.InputChanged, function(i)
		if not isMove(i) then return end
		if pending then
			local d = i.Position - startPos
			if d.Magnitude > 8 then
				pending = false
				if math.abs(d.X) >= math.abs(d.Y) then
					drag = true; scroller.ScrollingEnabled = false; fromInput(i)
				end
			end
		elseif drag then
			fromInput(i)
		end
	end)
	win:_connect(UIS.InputEnded, function(i)
		if not isPointer(i) then return end
		if pending then pending = false; fromInput(i) end -- короткое касание = поставить значение
		if drag then drag = false; scroller.ScrollingEnabled = true end
	end)
	function obj:Set(v, s) set(v, s, true) end
	function obj:Get() return value end
	local hk = self:_bindable(o) -- клавиша: +шаг, после максимума — снова минимум
	hk.action = function() set(value + inc > max and min or value + inc, false, true) end
	set(value, true); win:_register(o.Flag, obj, value)
	return obj
end

