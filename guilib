	end
	local function fromInput(i)
		local rel = (i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
		set(min + (max - min) * math.clamp(rel, 0, 1))
	end
	local drag = false
	hit.InputBegan:Connect(function(i) if isPointer(i) then drag = true; page.ScrollingEnabled = false; fromInput(i) end end)
	win:_connect(UIS.InputChanged, function(i) if drag and isMove(i) then fromInput(i) end end)
	win:_connect(UIS.InputEnded, function(i) if drag and isPointer(i) then drag = false; page.ScrollingEnabled = true end end)
	function obj:Set(v, s) set(v, s) end
