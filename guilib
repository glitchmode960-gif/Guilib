local NOTE_ICONS = { info = "i", success = "✓", warn = "!", warning = "!", error = "✕" }

local function dismiss(holder)
	if holder and holder.Parent and not holder:GetAttribute("Closing") then
		holder:SetAttribute("Closing", true)
		local note = holder:FindFirstChildOfClass("CanvasGroup")
		if note then tween(note, 0.22, { GroupTransparency = 1, Position = UDim2.fromOffset(60, 0) }) end
		task.delay(0.25, function() if holder then holder:Destroy() end end)
	end
end

function Window:_limitNotes()
	local list = {}
	for _, c in ipairs(self.Notes:GetChildren()) do
		if c:IsA("Frame") and not c:GetAttribute("Closing") then table.insert(list, c) end
	end
	while #list > MAX_NOTES do dismiss(table.remove(list, 1)) end
end

