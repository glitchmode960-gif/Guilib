		tween(row, 0.2, { Size = UDim2.new(1, 0, 0, v and (ROW + #options * 46 + 8) or ROW) }, Enum.EasingStyle.Quint)
		tween(arrow, 0.2, { Rotation = v and 180 or 0 })
