local function mkWinIcon(kind, btn)
	local col = Theme.SubText
	local function bar(rot)
		return create("Frame", {
			Size = UDim2.fromOffset(kind == "min" and 12 or 16, 2), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5), Rotation = rot, BackgroundColor3 = col, BorderSizePixel = 0, Parent = btn,
		})
	end
	if kind == "min" then
		bar(0)
	elseif kind == "max" then
		create("Frame", {
			Size = UDim2.fromOffset(11, 11), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			BackgroundTransparency = 1, BorderSizePixel = 0, Parent = btn,
		}, { create("UIStroke", { Color = col, Thickness = 1.5 }) })
	else
		bar(45); bar(-45)
	end
end

local function tint(btn, c)
	for _, d in ipairs(btn:GetDescendants()) do
		if d:IsA("UIStroke") then d.Color = c
		elseif d:IsA("Frame") and d.BackgroundTransparency < 1 then d.BackgroundColor3 = c end
	end
end

function Library:CreateWindow(opts)
