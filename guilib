function Library:SetTheme(name)
	local t = THEMES[name]
	if not t then return end
	local oldAccent, oldAccent2 = Theme.Accent, Theme.Accent2
	Theme.Accent = t.Accent
	Theme.Accent2 = t.Accent2

	for _, gui in ipairs(CoreGui:GetChildren()) do
		if gui.Name:sub(1, 7) == "GuiLib_" then
			for _, obj in ipairs(gui:GetDescendants()) do
				pcall(function()
					if obj:IsA("UIStroke") then
						if obj.Color == oldAccent then obj.Color = t.Accent
						elseif obj.Color == oldAccent2 then obj.Color = t.Accent2 end
					elseif obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("CanvasGroup") then
						if obj.BackgroundColor3 == oldAccent then obj.BackgroundColor3 = t.Accent
						elseif obj.BackgroundColor3 == oldAccent2 then obj.BackgroundColor3 = t.Accent2 end
					elseif obj:IsA("TextLabel") or obj:IsA("TextBox") then
						if obj.TextColor3 == oldAccent then obj.TextColor3 = t.Accent
						elseif obj.TextColor3 == oldAccent2 then obj.TextColor3 = t.Accent2 end
					elseif obj:IsA("UIGradient") then
						local cs = obj.Color
						if cs and cs.Keypoints then
							local kps = {}
							for _, kp in ipairs(cs.Keypoints) do
								local col = kp.Value
								if col == oldAccent then col = t.Accent
								elseif col == oldAccent2 then col = t.Accent2 end
								table.insert(kps, ColorSequenceKeypoint.new(kp.Time, col))
							end
							if #kps > 0 then obj.Color = ColorSequence.new(kps) end
						end
					end
				end)
			end
		end
	end
end

function Library:GetThemes()
	local list = {}
	for k, _ in pairs(THEMES) do table.insert(list, k) end
	table.sort(list)
	return list
end

function Library:CloseAll()
	for _, gui in ipairs(CoreGui:GetChildren()) do
		if gui.Name:sub(1, 7) == "GuiLib_" then gui:Destroy() end
	end
end

