function Library:AddFeatureTabs(win)
	local orig = {}

	----------------------------------------------------------------
	-- ДВИЖЕНИЕ
	----------------------------------------------------------------
	local tm = win:CreateTab("Движение")
	local S = {
		speed = false, speedV = 32, jump = false, jumpV = 60, grav = false, gravV = 80,
		inf = false, noclip = false, fly = false, flyV = 60,
	}

	local function restoreSpeed()
		local h = getHum()
		if h and orig.speed then h.WalkSpeed = orig.speed end
		orig.speed = nil
	end
	local function restoreJump()
		local h = getHum()
		if h and orig.jump then h.UseJumpPower = orig.useJP; h.JumpPower = orig.jump end
		orig.jump = nil
	end
	local function restoreGrav()
		if orig.grav then workspace.Gravity = orig.grav end
		orig.grav = nil
	end

	tm:AddSection("Скорость и прыжок")
	tm:AddToggle({ Name = "Скорость", Description = "Изменяет WalkSpeed", Flag = "speedOn",
		Callback = function(v) S.speed = v; if not v then restoreSpeed() end end })
	tm:AddSlider({ Name = "Значение скорости", Min = 16, Max = 250, Default = S.speedV, Flag = "speedV",
		Callback = function(v) S.speedV = v end })
	tm:AddToggle({ Name = "Сила прыжка", Description = "Изменяет JumpPower", Flag = "jumpOn",
		Callback = function(v) S.jump = v; if not v then restoreJump() end end })
	tm:AddSlider({ Name = "Значение прыжка", Min = 50, Max = 300, Default = S.jumpV, Flag = "jumpV",
		Callback = function(v) S.jumpV = v end })
	tm:AddToggle({ Name = "Гравитация", Description = "Стандартная в Roblox: 196.2", Flag = "gravOn",
		Callback = function(v) S.grav = v; if not v then restoreGrav() end end })
	tm:AddSlider({ Name = "Значение гравитации", Min = 0, Max = 300, Default = S.gravV, Flag = "gravV",
		Callback = function(v) S.gravV = v end })

	tm:AddSection("Перемещение")
	tm:AddToggle({ Name = "Бесконечный прыжок", Flag = "infJump", Callback = function(v) S.inf = v end })

	local touched = {}
	local function restoreNoclip()
		for p in pairs(touched) do if p.Parent then p.CanCollide = true end end
		table.clear(touched)
	end
	local noclipT = tm:AddToggle({ Name = "Noclip", Description = "Проходить сквозь стены", Flag = "noclip",
		Callback = function(v) S.noclip = v; if not v then restoreNoclip() end end })

	local bv, bg
	local function stopFly()
		if bv then bv:Destroy(); bv = nil end
		if bg then bg:Destroy(); bg = nil end
		local h = getHum()
		if h then h.PlatformStand = false end
	end
	local flyT = tm:AddToggle({ Name = "Полёт", Description = "Направление: куда смотрит камера", Flag = "fly",
		Callback = function(v) S.fly = v; if not v then stopFly() end end })
	tm:AddSlider({ Name = "Скорость полёта", Min = 10, Max = 250, Default = S.flyV, Flag = "flyV",
		Callback = function(v) S.flyV = v end })

	tm:AddSection("Клавиши (ПК)")
	tm:AddKeybind({ Name = "Полёт", Default = Enum.KeyCode.F, Flag = "kbFly",
		Callback = function() flyT:Set(not flyT:Get()) end })
	tm:AddKeybind({ Name = "Noclip", Default = Enum.KeyCode.N, Flag = "kbNoclip",
		Callback = function() noclipT:Set(not noclipT:Get()) end })

	-- применение значений каждый кадр (игры могут их сбрасывать)
	win:_connect(RunService.Heartbeat, function()
		local h = getHum()
		if h then
			if S.speed then
				if orig.speed == nil then orig.speed = h.WalkSpeed end
				h.WalkSpeed = S.speedV
			end
			if S.jump then
				if orig.jump == nil then orig.jump = h.JumpPower; orig.useJP = h.UseJumpPower end
				h.UseJumpPower = true
				h.JumpPower = S.jumpV
			end
		end
		if S.grav then
			if orig.grav == nil then orig.grav = workspace.Gravity end
			workspace.Gravity = S.gravV
		end
	end)

	win:_connect(UIS.JumpRequest, function()
		if S.inf then
			local h = getHum()
			if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end)

	win:_connect(RunService.Stepped, function()
		if not S.noclip then return end
		local c = LP.Character
		if not c then return end
		for _, p in ipairs(c:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then touched[p] = true; p.CanCollide = false end
		end
	end)

	win:_connect(RunService.RenderStepped, function()
		if not S.fly then return end
		local r, h, cam = getRoot(), getHum(), workspace.CurrentCamera
		if not (r and h and cam) then return end
		if not bv or bv.Parent ~= r then
			if bv then bv:Destroy() end
			if bg then bg:Destroy() end
			bv = create("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero, Parent = r })
			bg = create("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 9e4, CFrame = r.CFrame, Parent = r })
		end
		h.PlatformStand = true
		local dir = h.MoveDirection
		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		local vel = dir * S.flyV
		if flat.Magnitude > 0.01 and dir.Magnitude > 0.01 then
			vel += Vector3.new(0, look.Y * dir:Dot(flat.Unit) * S.flyV, 0)
		end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.new(0, S.flyV, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then vel -= Vector3.new(0, S.flyV, 0) end
		bv.Velocity = vel
		if flat.Magnitude > 0.01 then bg.CFrame = CFrame.lookAt(r.Position, r.Position + flat) end
	end)

	----------------------------------------------------------------
	-- ВИЗУАЛ
	----------------------------------------------------------------
	local tv = win:CreateTab("Визуал")
	local V = { fb = false, fov = false, fovV = 90, zoom = false }
	local lightOrig, fovOrig, zoomOrig

	local function applyFB()
		lightOrig = lightOrig or {
			Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, FogEnd = Lighting.FogEnd,
			GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
		}
		Lighting.Brightness = 2; Lighting.ClockTime = 14; Lighting.FogEnd = 1e6; Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(150, 150, 150); Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
	end
	local function restoreFB()
		if lightOrig then for k, v in pairs(lightOrig) do Lighting[k] = v end; lightOrig = nil end
	end
	local function restoreFov()
		local cam = workspace.CurrentCamera
		if cam and fovOrig then cam.FieldOfView = fovOrig end
		fovOrig = nil
	end
	local function restoreZoom()
		if zoomOrig then LP.CameraMaxZoomDistance = zoomOrig end
		zoomOrig = nil
	end

	tv:AddSection("Камера и свет")
	tv:AddToggle({ Name = "Fullbright", Description = "Убирает тьму и туман", Flag = "fullbright",
		Callback = function(v) V.fb = v; if not v then restoreFB() end end })
	tv:AddToggle({ Name = "Свой FOV", Flag = "fovOn",
		Callback = function(v) V.fov = v; if not v then restoreFov() end end })
	tv:AddSlider({ Name = "Значение FOV", Min = 30, Max = 120, Default = V.fovV, Flag = "fovV",
		Callback = function(v) V.fovV = v end })
	tv:AddToggle({ Name = "Увеличить зум камеры", Flag = "zoomOn", Callback = function(v)
		V.zoom = v
		if v then zoomOrig = zoomOrig or LP.CameraMaxZoomDistance; LP.CameraMaxZoomDistance = 1000 else restoreZoom() end
	end })

	local acc = 0
	win:_connect(RunService.Heartbeat, function(dt)
		acc += dt
		if acc >= 0.5 then
			acc = 0
			if V.fb then applyFB() end
		end
	end)
	win:_connect(RunService.RenderStepped, function()
		if V.fov then
			local cam = workspace.CurrentCamera
			if cam then
				fovOrig = fovOrig or cam.FieldOfView
				cam.FieldOfView = V.fovV
			end
		end
	end)

	-- ESP: подсветка игроков (Highlight) + имена и дистанция
	local esp = { on = false, names = true, team = false, color = Color3.fromRGB(255, 60, 60) }
	local espObjs = {}

	local function removeESP(p)
		local o = espObjs[p]
		if o then
			if o.hl then o.hl:Destroy() end
			if o.gui then o.gui:Destroy() end
			espObjs[p] = nil
		end
	end
	local function buildESP(p)
		removeESP(p)
		if not esp.on or p == LP then return end
		if esp.team and p.Team ~= nil and p.Team == LP.Team then return end
		local c = p.Character
		if not c then return end
		local o = {}
		o.hl = create("Highlight", {
			Adornee = c, FillColor = esp.color, OutlineColor = Color3.new(1, 1, 1), FillTransparency = 0.6,
			OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = c,
		})
		if esp.names then
			local head = c:FindFirstChild("Head")
			if head then
				o.gui = create("BillboardGui", {
					Adornee = head, AlwaysOnTop = true, Size = UDim2.fromOffset(140, 28),
					StudsOffset = Vector3.new(0, 2.4, 0), Parent = head,
				})
				o.label = create("TextLabel", {
					Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, TextColor3 = esp.color,
					TextStrokeTransparency = 0.4, Font = Enum.Font.GothamBold, TextSize = 13,
					Text = p.DisplayName, Parent = o.gui,
				})
			end
		end
		espObjs[p] = o
	end
	local function refreshESP()
		for _, p in ipairs(Players:GetPlayers()) do buildESP(p) end
	end
	local function clearESP()
		for p in pairs(espObjs) do removeESP(p) end
	end
	local function hookPlayer(p)
		win:_connect(p.CharacterAdded, function(c)
			c:WaitForChild("Head", 5)
			buildESP(p)
		end)
		if p.Character then buildESP(p) end
	end
	for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
	win:_connect(Players.PlayerAdded, hookPlayer)
	win:_connect(Players.PlayerRemoving, removeESP)

	local dAcc = 0
	win:_connect(RunService.Heartbeat, function(dt)
		dAcc += dt
		if dAcc < 0.25 then return end
		dAcc = 0
		local r = getRoot()
		for p, o in pairs(espObjs) do
			local pr = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if o.label and pr and r then
				o.label.Text = string.format("%s [%dm]", p.DisplayName, math.floor((pr.Position - r.Position).Magnitude))
			end
		end
	end)

	tv:AddSection("ESP игроков")
	tv:AddToggle({ Name = "ESP", Description = "Подсветка сквозь стены", Flag = "espOn",
		Callback = function(v) esp.on = v; if v then refreshESP() else clearESP() end end })
	tv:AddToggle({ Name = "Имена и дистанция", Default = true, Flag = "espNames",
		Callback = function(v) esp.names = v; refreshESP() end })
	tv:AddToggle({ Name = "Скрывать свою команду", Flag = "espTeam",
		Callback = function(v) esp.team = v; refreshESP() end })
	tv:AddColorPicker({ Name = "Цвет ESP", Default = esp.color, Flag = "espColor",
		Callback = function(c)
			esp.color = c
			for _, o in pairs(espObjs) do
				if o.hl then o.hl.FillColor = c end
				if o.label then o.label.TextColor3 = c end
			end
		end })

	----------------------------------------------------------------
	-- ПРОЧЕЕ
	----------------------------------------------------------------
	local tz = win:CreateTab("Прочее")
	tz:AddSection("Телепорт")
	local function playerNames()
		local l = {}
		for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then table.insert(l, p.Name) end end
		table.sort(l)
		return l
	end
	local tpTarget
	local tpDrop = tz:AddDropdown({ Name = "Игрок", Options = playerNames(), Callback = function(n) tpTarget = n end })
	local function refreshNames() if win.Gui.Parent then tpDrop:Refresh(playerNames()) end end
	win:_connect(Players.PlayerAdded, function() task.delay(0.5, refreshNames) end)
	win:_connect(Players.PlayerRemoving, function() task.delay(0.5, refreshNames) end)
	tz:AddButton({ Name = "Телепорт к игроку", Callback = function()
		local target = tpTarget and Players:FindFirstChild(tpTarget)
		local tr = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
		local r = getRoot()
		if r and tr then
			r.CFrame = tr.CFrame * CFrame.new(0, 0, 3)
			win:Notify({ Title = "Телепорт", Text = "К игроку " .. tpTarget, Type = "success", Duration = 2 })
		else
			win:Notify({ Title = "Ошибка", Text = "Выбери игрока, который сейчас в игре", Type = "error", Duration = 3 })
		end
	end })
	tz:AddButton({ Name = "Скопировать позицию", Callback = function()
		local r = getRoot()
		local copy = setclipboard or toclipboard
		if r and copy then
			local p = r.Position
			copy(string.format("%.1f, %.1f, %.1f", p.X, p.Y, p.Z))
			win:Notify({ Title = "Готово", Text = "Позиция скопирована", Type = "success", Duration = 2 })
		else
			win:Notify({ Title = "Ошибка", Text = "Буфер обмена недоступен", Type = "error", Duration = 3 })
		end
	end })

	tz:AddSection("Игра")
	local antiAfk = false
	tz:AddToggle({ Name = "Anti-AFK", Description = "Не даёт кикнуть за бездействие", Flag = "antiAfk",
		Callback = function(v) antiAfk = v end })
	win:_connect(LP.Idled, function()
		if antiAfk then
			pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.new())
			end)
		end
	end)
	tz:AddButton({ Name = "Сбросить персонажа", Callback = function()
		local h = getHum()
		if h then h.Health = 0 end
	end })
	tz:AddButton({ Name = "Перезайти на сервер", Callback = function()
		win:Dialog({
			Title = "Перезайти?", Text = "Ты выйдешь и зайдёшь на этот же плейс заново.",
			Buttons = {
				{ Text = "Отмена" },
				{ Text = "Перезайти", Primary = true, Callback = function() TeleportService:Teleport(game.PlaceId, LP) end },
			},
		})
	end })

	-- откат всех изменений при закрытии окна
	win:_onDestroy(function()
		restoreSpeed(); restoreJump(); restoreGrav(); restoreNoclip(); stopFly()
		restoreFB(); restoreFov(); restoreZoom(); clearESP()
	end)
end

----------------------------------------------------------------
-- Сворачиваемая секция: внутри те же Add* методы
-- local sec = tab:AddCollapsible("Название", true); sec:AddToggle({...})
----------------------------------------------------------------
function Tab:AddCollapsible(name, defaultOpen)
	local win = self.Window
	local open = defaultOpen ~= false
	local wrap = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = self.Page,
	})
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = wrap })
	local header = newRow(wrap, 34)
	header.LayoutOrder = 0
	label(header, name or "Section", UDim2.new(1, -44, 1, 0), UDim2.fromOffset(12, 0), 15).Font = Enum.Font.GothamBold
	local arrow = create("TextLabel", {
		Size = UDim2.fromOffset(24, 34), Position = UDim2.new(1, -30, 0, 0), BackgroundTransparency = 1,
		Text = "▾", TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 14,
		Rotation = open and 0 or -90, Parent = header,
	})
	local body = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = open and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
		BackgroundTransparency = 1, ClipsDescendants = true, LayoutOrder = 1, Parent = wrap,
	})
	local lay = create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })
	create("UIPadding", { PaddingLeft = UDim.new(0, 8), Parent = body })
	local sec = setmetatable({ Window = win, Page = body, Scroller = self.Scroller or self.Page, Name = name }, Tab)
	local token = 0
	local function unscale(px) return px / math.max(0.1, win.Scale.Scale) end
	function sec:SetOpen(v)
		if v == open then return end
		open = v
		token += 1
		local my = token
		tween(arrow, 0.2, { Rotation = v and 0 or -90 })
		body.AutomaticSize = Enum.AutomaticSize.None
		if v then
			tween(body, 0.22, { Size = UDim2.new(1, 0, 0, unscale(lay.AbsoluteContentSize.Y)) }, Enum.EasingStyle.Quint)
			task.delay(0.26, function()
				if my == token then body.AutomaticSize = Enum.AutomaticSize.Y; body.Size = UDim2.new(1, 0, 0, 0) end
			end)
		else
			body.Size = UDim2.new(1, 0, 0, unscale(body.AbsoluteSize.Y))
			tween(body, 0.22, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint)
		end
	end
	function sec:IsOpen() return open end
	onClick(clickArea(header), function() sec:SetOpen(not open) end)
	return sec
end

----------------------------------------------------------------
-- Общее API любого элемента: obj.Row, :SetVisible(bool), :SetName(текст), :Destroy()
----------------------------------------------------------------
do
	local names = {}
	for name, fn in pairs(Tab) do
		if type(fn) == "function" and (name:sub(1, 3) == "Add" or name:sub(1, 6) == "Create") then
			table.insert(names, name)
		end
	end
	for _, name in ipairs(names) do
		local fn = Tab[name]
		Tab[name] = function(self, ...)
			local page = self.Page
			local known = {}
			for _, c in ipairs(page:GetChildren()) do known[c] = true end
			local obj = fn(self, ...)
			if type(obj) ~= "table" then return obj end
			for _, c in ipairs(page:GetChildren()) do
				if not known[c] and c:IsA("GuiObject") then
					obj.Row = c
					function obj:SetVisible(v) c.Visible = v end
					function obj:SetName(text)
						local l = c:FindFirstChildWhichIsA("TextLabel", true)
						if l then l.Text = tostring(text) end
					end
					function obj:Destroy() c:Destroy() end
					break
				end
			end
			return obj
		end
	end
end

----------------------------------------------------------------
-- Настройки оформления запоминаются между запусками (тема, акцент, стекло, звук, анимации)
----------------------------------------------------------------
function Library:_prefsChanged()
	for _, w in ipairs(Library._windows) do w:_queueGeo() end
end

function Library:SetAnimations(v)
	Library.Animations = v and true or false
	Library:_prefsChanged()
end

function Library:_getPrefs()
	local a = Library._accent
	return {
		theme = Library._themeName, accent = a and { r = a.R, g = a.G, b = a.B } or nil,
		glass = Theme.GlassAlpha, sound = Library.SoundEnabled, volume = Library.SoundVolume, anim = Library.Animations,
	}
end

function Library:_applyPrefs(p)
	if type(p) ~= "table" then return end
	if type(p.sound) == "boolean" then Library.SoundEnabled = p.sound end
	if type(p.volume) == "number" then Library.SoundVolume = math.clamp(p.volume, 0, 1) end
	if type(p.anim) == "boolean" then Library.Animations = p.anim end
	if type(p.glass) == "number" then Theme.GlassAlpha = math.clamp(p.glass, 0, 0.8) end
	if type(p.theme) == "string" then
		Library:SetTheme(p.theme)
	elseif type(p.accent) == "table" and p.accent.r then
		Library:SetAccent(Color3.new(p.accent.r, p.accent.g, p.accent.b))
	end
end

----------------------------------------------------------------
-- Экспорт / импорт конфига через буфер обмена
----------------------------------------------------------------
function Window:ExportConfig()
	local ok, s = pcall(function() return HttpService:JSONEncode(encodeV(self.Flags)) end)
	return ok and s or nil
end

function Window:ImportConfig(json, fire)
	local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok or type(data) ~= "table" then return false end
	Library._mute = true
	for flag, value in pairs(data) do
		local setter = self._setters[flag]
		if setter then pcall(setter, decodeV(value), fire == false) end
	end
	Library._mute = false
	return true
end


return Library
