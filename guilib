function Window:SetClickFx(cfg)
	cfg = cfg or {}
	if self._fxConn then self._fxConn:Disconnect(); self._fxConn = nil end
	if not cfg.Enabled then return end
	local color = cfg.Color or Theme.Accent
	local size = cfg.Size or 80
	local dur = cfg.Duration or 0.65
	self._fxConn = self:_connect(UIS.InputBegan, function(i)
		if not isPointer(i) then return end
		local pos = screenPos(i)
		local c = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(pos.X, pos.Y),
			Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, BorderSizePixel = 0,
			ZIndex = 100, Parent = self.Gui,
		}, { round() })
		local st = create("UIStroke", { Color = color, Thickness = 3, Transparency = 0.1, Parent = c })
		c:SetAttribute("NoTheme", true)
		tween(c, dur, { Size = UDim2.fromOffset(size, size) })
		tween(st, dur, { Transparency = 1, Thickness = 1 })
		task.delay(dur + 0.05, function() c:Destroy() end)
	end)
end

function Library:SetWatermark(win, visible)
	if win._wmConn then win._wmConn:Disconnect(); win._wmConn = nil end
	if win._wm then win._wm:Destroy(); win._wm = nil end
	if not visible then return end
	local wm = create("TextLabel", {
		Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 6), BackgroundColor3 = Theme.Topbar,
		BorderSizePixel = 0, Text = Library.Brand, TextColor3 = Theme.Text, Font = Enum.Font.GothamBold,
		TextSize = 11, Parent = win.Gui,
	}, { round(), create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) })
	win._wm = wm
	local frames, acc = 0, 0
	win._wmConn = RunService.Heartbeat:Connect(function(dt)
		frames += 1; acc += dt
		if acc >= 0.5 then
			wm.Text = string.format("%s  |  %s  |  %d FPS", Library.Brand, LP.Name, math.floor(frames / acc + 0.5))
			frames, acc = 0, 0
		end
	end)
	table.insert(win._conns, win._wmConn)
end

