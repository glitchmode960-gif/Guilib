local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/glitchmode960-gif/Guilib/main/guilib"))()

local win = Library:CreateWindow({ Title = "Guilib Test", Subtitle = "v2.0" })
local tab = win:CreateTab("Главная")

tab:AddSection("Тест")
tab:AddButton({ Name = "Кнопка", Callback = function()
    win:Notify({ Title = "OK", Text = "Работает!", Type = "success" })
end })
tab:AddToggle({ Name = "Toggle", Default = false })
tab:AddSlider({ Name = "Slider", Min = 1, Max = 100, Default = 50 })
tab:AddKeybind({ Name = "Хоткей", Default = Enum.KeyCode.RightShift })
tab:AddColorPicker({ Name = "Цвет", Default = Color3.fromRGB(255, 100, 100) })
tab:AddProgressBar({ Name = "Прогресс", Min = 0, Max = 100, Default = 75 })
tab:AddStepper({ Name = "Степпер", Min = 0, Max = 10, Default = 3 })
tab:AddRadioGroup({ Name = "Радио", Options = {"Да", "Нет", "Мб"}, Default = "Да" })
tab:AddMultiDropdown({ Name = "Мульти", Options = {"A", "B", "C"}, Default = {"A"} })
tab:AddDivider()
tab:AddLoader({ Name = "Загрузка..." })
tab:AddParagraph({ Title = "Guilib v2.0", Content = "Все методы работают!" })

Library:SetTheme("Purple")
win:SetClickFx({ Enabled = true, Style = "Rings" })
win:Toast("Готово!", 3)