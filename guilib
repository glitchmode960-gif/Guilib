	})
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sb })
	self._sbList = sb

	self.Pages = create("Frame", {
		Size = UDim2.new(1, -sw, 1, 0), Position = UDim2.fromOffset(sw, 0),
		BackgroundTransparency = 1, ClipsDescendants = true, Parent = self.Body,
	})

	self.Notes = create("Frame", {
		Size = UDim2.fromOffset(math.min(340, cam.ViewportSize.X * 0.9), 400),
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 60),
		BackgroundTransparency = 1, Parent = self.Gui,
	})
	create("UIListLayout", { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = self.Notes })

	self.Fab = create("TextButton", {
		Size = UDim2.fromOffset(52, 52), Position = UDim2.new(0, 16, 0.45, 0),
		BackgroundColor3 = Theme.Topbar, BackgroundTransparency = 0.15, Text = title:sub(1, 1):upper(),
		TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 22, AutoButtonColor = false, Parent = self.Gui,
	}, { corner(14), stroke() })

	local function snapFab()
		local v, f = cam.ViewportSize, self.Fab
		local tx = (f.AbsolutePosition.X + f.AbsoluteSize.X / 2 < v.X / 2) and 12 or (v.X - f.AbsoluteSize.X - 12)
		local ty = math.clamp(f.AbsolutePosition.Y, 12, v.Y - f.AbsoluteSize.Y - 12)
		tween(f, 0.25, { Position = UDim2.fromOffset(tx, ty) }, Enum.EasingStyle.Quint)
	end
	local function clampMain()
		local v, m = cam.ViewportSize, self.Main
		local c = m.AbsolutePosition + m.AbsoluteSize / 2
		local cx, cy = math.clamp(c.X, 80, v.X - 80), math.clamp(c.Y, 40, v.Y - 40)
		if cx ~= c.X or cy ~= c.Y then tween(m, 0.2, { Position = UDim2.fromOffset(cx, cy) }) end
	end

	self:_drag(header, self.Main, nil, clampMain)
	self:_drag(self.Fab, self.Fab, function() self:SetOpen(not self.Open) end, snapFab)

	self:_connect(UIS.InputBegan, function(i, processed)
		if not processed and i.KeyCode == self.ToggleKey then self:SetOpen(not self.Open) end
	end)

	self:_connect(cam:GetPropertyChangedSignal("ViewportSize"), function()
		self._size = fullSize()
		self.Main.Size = UDim2.fromOffset(self._size.X, self.Minimized and 48 or self._size.Y)
