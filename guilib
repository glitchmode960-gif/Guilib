-- Элементы вкладки (все принимают таблицу параметров)
----------------------------------------------------------------
function Tab:AddSection(text)
	local l = label(self.Page, string.upper(text or ""), UDim2.new(1, 0, 0, 24), nil, 12)
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = Theme.Accent2
end

function Tab:AddLabel(text)
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Parent = self.Page,
	}, {
		corner(10),
		stroke(Theme.Stroke, 0.6),
		create("UIPadding", {
			PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12),
			PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
		}),
	})
	local l = label(row, text, UDim2.new(1, 0, 0, 0))
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.TextWrapped = true
	l.TextTruncate = Enum.TextTruncate.None
	l.TextColor3 = Theme.SubText
	return { Set = function(_, v) l.Text = v end }
end

function Tab:AddButton(o)
	local row = newRow(self.Page)
	local l = label(row, o.Name, UDim2.new(1, -28, 1, 0), UDim2.fromOffset(14, 0))
	l.TextXAlignment = Enum.TextXAlignment.Center
	local btn = clickArea(row)
	btn.MouseButton1Click:Connect(function() safe(o.Callback) end)
end

function Tab:AddToggle(o)
	local win = self.Window
	local state = o.Default or false
	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(1, -90, 1, 0), UDim2.fromOffset(14, 0))
	local sw = create("Frame", {
		Size = UDim2.fromOffset(48, 26),
		Position = UDim2.new(1, -62, 0.5, -13),
		BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0,
		Parent = row,
	}, { round() })
	local knob = create("Frame", {
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = sw,
	}, { round() })
	local btn = clickArea(row)

	local obj = {}
	local function set(v, silent)
		state = v and true or false
		if o.Flag then win.Flags[o.Flag] = state end
		tween(sw, 0.18, { BackgroundColor3 = state and Theme.Accent or Theme.Hover })
		tween(knob, 0.18, { Position = state and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3) }, Enum.EasingStyle.Back)
		if not silent then safe(o.Callback, state) end
	end
	btn.MouseButton1Click:Connect(function() set(not state) end)
	function obj:Set(v) set(v) end
	function obj:Get() return state end
	set(state, true)
	win:_register(o.Flag, obj, state)
	return obj
end

function Tab:AddSlider(o)
	local win, page = self.Window, self.Page
	local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
	local value = o.Default or min
	local row = newRow(page, 64)
	label(row, o.Name, UDim2.new(1, -100, 0, 28), UDim2.fromOffset(14, 6))
	local valueLabel = label(row, "", UDim2.new(0, 80, 0, 28), UDim2.new(1, -94, 0, 6))
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.TextColor3 = Theme.SubText

	local bar = create("Frame", {
		Size = UDim2.new(1, -28, 0, 8),
		Position = UDim2.fromOffset(14, 44),
		BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0,
		Parent = row,
	}, { round() })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = bar,
	}, { round(), gradient(0) })
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.fromScale(1, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = fill,
	}, { round(), stroke(Theme.Accent, 0, 2) })

	-- большая зона касания, чтобы попадать пальцем
	local hit = create("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromOffset(0, 24),
		BackgroundTransparency = 1,
		Active = true,
		Parent = row,
	})

	local obj = {}
	local function set(v, silent)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = math.clamp(math.floor(v * 10000 + 0.5) / 10000, min, max)
		value = v
		if o.Flag then win.Flags[o.Flag] = v end
		valueLabel.Text = tostring(v) .. (o.Suffix or "")
		fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
		if not silent then safe(o.Callback, v) end
	end
	local function fromInput(input)
		local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
		set(min + (max - min) * math.clamp(rel, 0, 1))
	end

	local dragging = false
	hit.InputBegan:Connect(function(input)
		if isPointer(input) then
			dragging = true
			page.ScrollingEnabled = false -- чтобы страница не скроллилась при перетаскивании
			fromInput(input)
		end
	end)
	win:_connect(UIS.InputChanged, function(input)
		if dragging and isMove(input) then fromInput(input) end
	end)
	win:_connect(UIS.InputEnded, function(input)
		if dragging and isPointer(input) then
			dragging = false
			page.ScrollingEnabled = true
		end
	end)

	function obj:Set(v) set(v) end
	function obj:Get() return value end
	set(value, true)
	win:_register(o.Flag, obj, value)
	return obj
end

function Tab:AddTextbox(o)
	local win = self.Window
	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(0.45, -14, 1, 0), UDim2.fromOffset(14, 0))
	local box = create("TextBox", {
		Size = UDim2.new(0.55, -22, 0, 32),
		Position = UDim2.new(0.45, 8, 0.5, -16),
		BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0,
		Text = o.Default or "",
		PlaceholderText = o.Placeholder or "",
		PlaceholderColor3 = Theme.SubText,
		TextColor3 = Theme.Text,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		ClearTextOnFocus = false,
		Parent = row,
	}, { corner(8), create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })

	local obj = {}
	box.FocusLost:Connect(function(enter)
		if o.Flag then win.Flags[o.Flag] = box.Text end
		safe(o.Callback, box.Text, enter)
	end)
	function obj:Get() return box.Text end
	function obj:Set(v) box.Text = tostring(v) if o.Flag then win.Flags[o.Flag] = box.Text end end
	win:_register(o.Flag, obj, box.Text)
	return obj
end

function Tab:AddDropdown(o)
	local win = self.Window
	local options = o.Options or {}
	local current = o.Default
	local open = false

	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(0.5, -14, 0, ROW), UDim2.fromOffset(14, 0))
	local selected = label(row, "", UDim2.new(0.5, -40, 0, ROW), UDim2.new(0.5, 0, 0, 0))
	selected.TextXAlignment = Enum.TextXAlignment.Right
	selected.TextColor3 = Theme.SubText
	local arrow = create("TextLabel", {
		Size = UDim2.fromOffset(24, ROW),
		Position = UDim2.new(1, -30, 0, 0),
		BackgroundTransparency = 1,
		Text = "v",
		TextColor3 = Theme.Accent2,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		Parent = row,
	})
	local header = clickArea(row, ROW)

	local list = create("Frame", {
		Position = UDim2.fromOffset(0, ROW),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		Parent = row,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 4),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = list,
	})

	local obj = {}
	local buttons = {}

	local function setOpen(v)
		open = v
		tween(row, 0.2, { Size = UDim2.new(1, 0, 0, v and (ROW + #options * 42 + 6) or ROW) }, Enum.EasingStyle.Quint)
		tween(arrow, 0.2, { Rotation = v and 180 or 0 })
	end
	local function select(opt, silent)
		current = opt
		selected.Text = tostring(opt == nil and "-" or opt)
		if o.Flag then win.Flags[o.Flag] = opt end
		for value, b in pairs(buttons) do
			tween(b, 0.15, { BackgroundColor3 = value == opt and Theme.Accent or Theme.Hover })
		end
		if not silent then safe(o.Callback, opt) end
	end
	local function build()
		for _, b in pairs(buttons) do b:Destroy() end
		table.clear(buttons)
		for _, opt in ipairs(options) do
			local b = create("TextButton", {
				Size = UDim2.new(1, -20, 0, 38),
				BackgroundColor3 = Theme.Hover,
				BorderSizePixel = 0,
				Text = tostring(opt),
				TextColor3 = Theme.Text,
				Font = Enum.Font.GothamMedium,
				TextSize = 14,
				AutoButtonColor = false,
				Parent = list,
			}, { corner(8) })
			b.MouseButton1Click:Connect(function()
				select(opt)
				setOpen(false)
			end)
			buttons[opt] = b
		end
	end

	header.MouseButton1Click:Connect(function() setOpen(not open) end)
	function obj:Get() return current end
	function obj:Set(v) select(v) end
	function obj:Refresh(newOptions)
		options = newOptions
		build()
		select(current, true)
		if open then setOpen(true) end
	end

	build()
	select(current, true)
	win:_register(o.Flag, obj, current)
	return obj
end

return Library
