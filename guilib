	local row = newRow(page, 72)
	label(row, o.Name, UDim2.new(1, -110, 0, 28), UDim2.fromOffset(16, 10), 15).Font = Enum.Font.GothamMedium
	local vl = label(row, "", UDim2.new(0, 90, 0, 28), UDim2.new(1, -106, 0, 10), 14)
	vl.TextXAlignment = Enum.TextXAlignment.Right; vl.TextColor3 = Theme.Accent; vl.Font = Enum.Font.GothamBold
