-- ============================================================
-- CONFIG
-- ============================================================
function Window:_register(flag, obj, value)
	if not flag then return end
	self.Flags[flag] = value
	self._setters[flag] = function(v, silent) if obj.Set then obj:Set(v, silent) end end
	-- AutoSave
	local oldSet = obj.Set
	if oldSet then
		obj.Set = function(s, v, silent)
			oldSet(s, v, silent)
			if not silent and s and self._autoSave then
				task.delay(0.5, function() s:SaveConfig() end)
			end
		end
	end
end

function Window:SaveConfig(name)
	if typeof(writefile) ~= "function" then return false end
	local enc = encodeV(self.Flags)
	local ok, data = pcall(function() return HttpService:JSONEncode(enc) end)
	if not ok then return false end
	return pcall(function() writefile("GuiLib_" .. (name or self.ConfigName) .. ".json", data) end)
end

function Window:LoadConfig(name)
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then return false end
	local file = "GuiLib_" .. (name or self.ConfigName) .. ".json"
	if not isfile(file) then return false end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
	if not ok or type(data) ~= "table" then return false end
	for flag, value in pairs(data) do
		if self._setters[flag] then pcall(function() self._setters[flag](decodeV(value), true) end) end
	end
	return true
end

