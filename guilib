	})
	local marker = create("Frame", {
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(s, 0, 1 - v, 0),
		BackgroundTransparency = 1,
		Parent = sv,
	}, { round(), stroke(Color3.new(1, 1, 1), 0, 2) })

	local hue = create("Frame", {
		Size = UDim2.new(1, -28, 0, 14),
		Position = UDim2.fromOffset(14, 114),
		BackgroundColor3 = Color3.fromRGB(255, 0, 0),
		BorderSizePixel = 0,
		Parent = holder,
	}, { round() })
	local hg = create("UIGradient", { Parent = hue })
	hg.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
		ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
		ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
		ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
		ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
	})
	local hMarker = create("Frame", {
		Size = UDim2.fromOffset(18, 18),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(h, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = hue,
	}, { round(), stroke(Color3.new(0, 0, 0), 0.5, 2) })

	local function apply(silent)
		color = Color3.fromHSV(h, s, v)
		preview.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		wg.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(h, 1, 1))
		marker.Position = UDim2.new(s, 0, 1 - v, 0)
		hMarker.Position = UDim2.new(h, 0, 0.5, 0)
		if o.Flag then win.Flags[o.Flag] = color end
		if not silent then safe(o.Callback, color) end
	end

	local dragSV, dragH = false, false
	local function handleSV(input)
		local px = (input.Position.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X
		local py = (input.Position.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y
		s = math.clamp(px, 0, 1)
		v = 1 - math.clamp(py, 0, 1)
		apply()
	end
	local function handleH(input)
		h = math.clamp((input.Position.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
		apply()
	end

	sv.InputBegan:Connect(function(input) if isPointer(input) then dragSV = true; handleSV(input) end end)
	hue.InputBegan:Connect(function(input) if isPointer(input) then dragH = true; handleH(input) end end)
	win:_connect(UIS.InputChanged, function(input)
		if not isMove(input) then return end
		if dragSV then handleSV(input) end
		if dragH then handleH(input) end
	end)
	win:_connect(UIS.InputEnded, function(input)
		if isPointer(input) then dragSV = false; dragH = false end
	end)

	header.MouseButton1Click:Connect(function()
		open = not open
		tween(row, 0.22, { Size = UDim2.new(1, 0, 0, open and (ROW + 140) or ROW) }, Enum.EasingStyle.Quint)
		holder.Size = UDim2.new(1, 0, 0, open and 140 or 0)
	end)

	local obj = {}
	function obj:Get() return color end
	function obj:Set(c, s) 
		if typeof(c) == "Color3" then
			h, s2, v = Color3.toHSV(c)
			s = s2
			apply(true) 
		end
	end
	apply(true)
	win:_register(o.Flag, obj, color)
	return obj
end

