Library.SoundVolume = 0.5
Library.Sounds = {
	Hover = "rbxassetid://119354387183704",
	Click = "rbxassetid://6042053626",
	ToggleOn = "rbxassetid://140207837688369",
	ToggleOff = "rbxassetid://139009780109934",
	Open = "rbxassetid://78897892629188",
	Close = "rbxassetid://78299875784295",
	Notify = "rbxassetid://117653664939966",
}
local soundObjs, lastPlay = {}, {}

local function getSound(name)
	local s = soundObjs[name]
	if s and s.Parent then return s end
	local id = Library.Sounds[name]
	if not id then return nil end
	s = Instance.new("Sound")
	s.Name = "GuiLib_" .. name
	s.SoundId = id
	s.Volume = Library.SoundVolume
	s.Parent = SoundService
	soundObjs[name] = s
	return s
end

function Library:PlaySound(name)
	if not Library.SoundEnabled or Library._mute then return end
	local now = os.clock()
	if lastPlay[name] and now - lastPlay[name] < (name == "Hover" and 0.08 or 0.03) then return end
	lastPlay[name] = now
	local s = getSound(name)
	if not s then return end
	s.Volume = Library.SoundVolume * (name == "Hover" and 0.6 or 1)
	s.TimePosition = 0
	s:Play()
end

function Library:SetSoundsEnabled(on) Library.SoundEnabled = on and true or false; Library:_prefsChanged() end
function Library:SetSoundVolume(v) Library.SoundVolume = math.clamp(tonumber(v) or 0.5, 0, 1); Library:_prefsChanged() end

local function preloadSounds()
	local list = {}
	for name in pairs(Library.Sounds) do
		local s = getSound(name)
		if s then table.insert(list, s) end
	end
	task.spawn(function() pcall(function() ContentProvider:PreloadAsync(list) end) end)
end

local function destroySounds()
	for k, s in pairs(soundObjs) do s:Destroy(); soundObjs[k] = nil end
end

