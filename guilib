local function ripple(row, input)
	if Library.Animations == false then return end
	local x = input.Position.X - row.AbsolutePosition.X
	local c = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, x, 0, math.min(row.AbsoluteSize.Y, ROW) / 2),
		Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.85, BorderSizePixel = 0, ZIndex = 2, Parent = row,
	}, { round() })
	local d = math.max(row.AbsoluteSize.X, 80) * 1.6
	tween(c, 0.5, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 })
	task.delay(0.55, function() c:Destroy() end)
end

-- общая «строка-кнопка»: hover-звук и подсветка, ripple, звук клика,
-- тултип (мышь: наведение 0.45с, тач: удержание), OnHold (мышь: удержание 0.8с)
local function clickArea(row, h, o)
	o = o or {}
	local b = create("TextButton", {
		Size = h and UDim2.new(1, 0, 0, h) or UDim2.fromScale(1, 1),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = row,
	})
	local hoverTok, holdTok, held = 0, 0, false
	b.MouseEnter:Connect(function()
		Library:PlaySound("Hover")
		tween(row, 0.12, { BackgroundTransparency = math.max(0, Theme.RowAlpha - 0.12) })
		if o.Tooltip then
			hoverTok += 1
			local my = hoverTok
			task.delay(0.45, function()
				if my == hoverTok and b.Parent then
					local g = b:FindFirstAncestorWhichIsA("ScreenGui")
					if g then showTip(g, o.Tooltip) end
				end
			end)
		end
	end)
	b.MouseLeave:Connect(function()
		hoverTok += 1
		hideTip()
		tween(row, 0.15, { BackgroundTransparency = Theme.RowAlpha })
	end)
	b.InputBegan:Connect(function(i)
		if not isPointer(i) then return end
		b:SetAttribute("Suppress", nil)
		ripple(row, i)
		tween(row, 0.1, { BackgroundColor3 = Theme.Hover })
		if not o.NoClick then Library:PlaySound("Click") end
		held = true
		holdTok += 1
		local my = holdTok
		local touch = i.UserInputType == Enum.UserInputType.Touch
		if touch and o.Tooltip then
			task.delay(0.45, function()
				if my == holdTok and held then
					local g = b:FindFirstAncestorWhichIsA("ScreenGui")
					if g then showTip(g, o.Tooltip, screenPos(i)) end
				end
			end)
		end
		if not touch and o.OnHold then
			task.delay(0.8, function()
				if my == holdTok and held then
					b:SetAttribute("Suppress", true) -- не считать отпускание кликом
					o.OnHold()
				end
			end)
		end
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then
				held = false
				holdTok += 1
				tween(row, 0.2, { BackgroundColor3 = Theme.Element })
				if touch then hideTip() end
			end
		end)
	end)
	return b
end

local function onClick(btn, fn)
	btn.MouseButton1Click:Connect(function()
		if btn:GetAttribute("Suppress") then btn:SetAttribute("Suppress", nil); return end
		fn()
	end)
end

-- hover/click/ripple для мелких кнопок (степпер, пункты списков, бейдж клавиши)
local function fx(btn, target, quiet)
	btn.MouseEnter:Connect(function() Library:PlaySound("Hover") end)
	btn.InputBegan:Connect(function(i)
		if isPointer(i) then
			if target then ripple(target, i) end
			if not quiet then Library:PlaySound("Click") end
		end
	end)
end

-- плавное «докручивание» числа: st = { val = число }, fn(x) отрисовывает значение
local function animNumber(st, to, dur, fn)
	st.tok = (st.tok or 0) + 1
	local my, from, t0 = st.tok, st.val or 0, os.clock()
	task.spawn(function()
		while st.tok == my do
			local a = math.clamp((os.clock() - t0) / dur, 0, 1)
			st.val = from + (to - from) * (1 - (1 - a) ^ 3)
			fn(st.val)
			if a >= 1 then break end
			RunService.RenderStepped:Wait()
		end
	end)
end

local function snapNumber(st, v, fn)
	st.tok = (st.tok or 0) + 1
	st.val = v
	fn(v)
end

local function encodeV(v)
	if typeof(v) == "Color3" then return { __t = "Color3", r = v.R, g = v.G, b = v.B } end
	if typeof(v) == "EnumItem" then return { __t = "Enum", name = v.Name } end
	if type(v) == "table" then local o = {}; for k, x in pairs(v) do o[k] = encodeV(x) end; return o end
	return v
end
local function decodeV(v)
	if type(v) == "table" then
		if v.__t == "Color3" then return Color3.new(v.r, v.g, v.b) end
		if v.__t == "Enum" then return Enum.KeyCode[v.name] or v.name end
		local o = {}; for k, x in pairs(v) do o[k] = decodeV(x) end; return o
	end
	return v
end

