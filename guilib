-- Keybind: Callback срабатывает при нажатии клавиши, OnChanged — при смене привязки
function Tab:AddKeybind(o)
	local win = self.Window
	local key = o.Default or Enum.KeyCode.RightShift
	local listening = false
	local row = newRow(self.Page)
	label(row, o.Name or "Keybind", UDim2.new(1, -110, 1, 0), UDim2.fromOffset(12, 0), 15).Font = Enum.Font.GothamMedium
	local badge = create("TextButton", {
		Size = UDim2.fromOffset(88, 28), Position = UDim2.new(1, -100, 0.5, -14), BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0, Text = key.Name, TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold,
		TextSize = 13, AutoButtonColor = false, Parent = row,
	}, { corner(10) })
	local obj = {}
	fx(badge, row)
	local function refresh() badge.Text = listening and "..." or key.Name end
	badge.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true; refresh()
		local conn
		conn = UIS.InputBegan:Connect(function(i)
			if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
			conn:Disconnect()
			if i.KeyCode ~= Enum.KeyCode.Escape then
				key = i.KeyCode
				win:_setFlag(o.Flag, key.Name)
				safe(o.OnChanged, key)
			end
			task.defer(function() listening = false; refresh() end) -- чтобы нажатие не вызвало Callback
		end)
		table.insert(win._conns, conn)
	end)
	win:_connect(UIS.InputBegan, function(i, p)
		if p or listening then return end
		if i.KeyCode == key then safe(o.Callback, key) end
	end)
	function obj:Get() return key end
	function obj:Set(v, s)
		key = typeof(v) == "string" and (Enum.KeyCode[v] or key) or v
		refresh(); win:_setFlag(o.Flag, key.Name, s)
		if not s then safe(o.OnChanged, key) end
	end
	win:_register(o.Flag, obj, key.Name)
	return obj
end

