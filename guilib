function Tab:AddLabel(text)
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Parent = self.Page },
		{ corner(12), create("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
			PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }) })
	local l = label(row, text, UDim2.new(1, 0, 0, 0))
	l.AutomaticSize = Enum.AutomaticSize.Y; l.TextWrapped = true
	l.TextTruncate = Enum.TextTruncate.None; l.TextColor3 = Theme.SubText
	return { Set = function(_, v) l.Text = v end }
end

function Tab:AddButton(o)
	local row = newRow(self.Page)
	local l = label(row, o.Name or "Button", UDim2.new(1, -32, 1, 0), UDim2.fromOffset(16, 0), 15)
	l.TextXAlignment = Enum.TextXAlignment.Left; l.Font = Enum.Font.GothamMedium
	local btn = clickArea(row)
	btn.MouseButton1Click:Connect(function() safe(o.Callback) end)
	return row
end

function Tab:AddToggle(o)
	local win = self.Window
	local state = o.Default or false
	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(1, -90, 1, 0), UDim2.fromOffset(16, 0), 15).Font = Enum.Font.GothamMedium
	local sw = create("Frame", { Size = UDim2.fromOffset(52, 30), Position = UDim2.new(1, -68, 0.5, -15),
		BackgroundColor3 = state and Theme.Accent or Theme.Hover, BorderSizePixel = 0, Parent = row }, { round() })
	local knob = create("Frame", { Size = UDim2.fromOffset(24, 24),
		Position = state and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sw }, { round() })
	local btn = clickArea(row)
	local obj = {}
	local function set(v, silent)
		state = v and true or false
		if o.Flag then win.Flags[o.Flag] = state end
		tween(sw, 0.22, { BackgroundColor3 = state and Theme.Accent or Theme.Hover })
		tween(knob, 0.22, { Position = state and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3) }, Enum.EasingStyle.Quint)
		if not silent then safe(o.Callback, state) end
	end
	btn.MouseButton1Click:Connect(function() set(not state) end)
	function obj:Set(v, s) set(v, s) end
	function obj:Get() return state end
	set(state, true); win:_register(o.Flag, obj, state)
	return obj
end

function Tab:AddSlider(o)
	local win, page = self.Window, self.Page
	local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
	local value = o.Default or min
	local row = newRow(page, 72)
	label(row, o.Name, UDim2.new(1, -110, 0, 28), UDim2.fromOffset(16, 10), 15).Font = Enum.Font.GothamMedium
	local vl = label(row, "", UDim2.new(0, 90, 0, 28), UDim2.new(1, -106, 0, 10), 14)
	vl.TextXAlignment = Enum.TextXAlignment.Right; vl.TextColor3 = Theme.Accent; vl.Font = Enum.Font.GothamBold
	local bar = create("Frame", { Size = UDim2.new(1, -32, 0, 10), Position = UDim2.fromOffset(16, 48),
		BackgroundColor3 = Theme.Hover, BorderSizePixel = 0, Parent = row }, { round() })
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0, Parent = bar }, { round() })
	create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(22, 22),
		Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, Parent = fill }, { round() })
	local hit = create("Frame", { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 28),
		BackgroundTransparency = 1, Active = true, Parent = row })
	local obj = {}
	local function set(v, silent)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = math.clamp(math.floor(v * 10000 + 0.5) / 10000, min, max); value = v
		if o.Flag then win.Flags[o.Flag] = v end
		vl.Text = tostring(v) .. (o.Suffix or "")
		fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
		if not silent then safe(o.Callback, v) end
	end
	local function fromInput(i)
		local rel = (i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
		set(min + (max - min) * math.clamp(rel, 0, 1))
	end
	local drag = false
	hit.InputBegan:Connect(function(i) if isPointer(i) then drag = true; page.ScrollingEnabled = false; fromInput(i) end end)
	win:_connect(UIS.InputChanged, function(i) if drag and isMove(i) then fromInput(i) end end)
	win:_connect(UIS.InputEnded, function(i) if drag and isPointer(i) then drag = false; page.ScrollingEnabled = true end end)
	function obj:Set(v, s) set(v, s) end
	function obj:Get() return value end
	set(value, true); win:_register(o.Flag, obj, value)
	return obj
end

function Tab:AddTextbox(o)
	local win = self.Window
	local row = newRow(self.Page, 64)
	local l = label(row, o.Name or "Input", UDim2.new(0.4, -16, 0, 18), UDim2.fromOffset(16, 8), 13)
	l.TextColor3 = Theme.SubText
	local box = create("TextBox", {
		Size = UDim2.new(0.6, -24, 0, 40), Position = UDim2.new(0.4, 8, 0.5, -20),
		BackgroundColor3 = Theme.Hover, BorderSizePixel = 0, Text = o.Default or "",
		PlaceholderText = o.Placeholder or "", PlaceholderColor3 = Theme.SubText,
		TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 14,
		ClearTextOnFocus = false, Parent = row,
	}, { corner(10), create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
	local obj = {}
	box.FocusLost:Connect(function(e)
		if o.Flag then win.Flags[o.Flag] = box.Text end
		safe(o.Callback, box.Text, e)
	end)
	function obj:Get() return box.Text end
