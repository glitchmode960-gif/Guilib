local THEMES = {
	Purple = { Accent = Color3.fromRGB(120, 90, 255), Accent2 = Color3.fromRGB(70, 160, 255) },
	Blue   = { Accent = Color3.fromRGB(70, 120, 255), Accent2 = Color3.fromRGB(120, 180, 255) },
	Red    = { Accent = Color3.fromRGB(235, 70, 90),  Accent2 = Color3.fromRGB(255, 140, 150) },
	Green  = { Accent = Color3.fromRGB(60, 200, 120), Accent2 = Color3.fromRGB(150, 240, 190) },
	Orange = { Accent = Color3.fromRGB(255, 150, 60), Accent2 = Color3.fromRGB(255, 200, 130) },
	Pink   = { Accent = Color3.fromRGB(255, 100, 200),Accent2 = Color3.fromRGB(255, 170, 230) },
	Cyan   = { Accent = Color3.fromRGB(60, 200, 230), Accent2 = Color3.fromRGB(150, 240, 250) },
	Lime   = { Accent = Color3.fromRGB(170, 230, 60), Accent2 = Color3.fromRGB(220, 250, 130) },
	Gold   = { Accent = Color3.fromRGB(235, 190, 60), Accent2 = Color3.fromRGB(255, 230, 140) },
	Rose   = { Accent = Color3.fromRGB(255, 110, 150),Accent2 = Color3.fromRGB(255, 170, 190) },
	Mint   = { Accent = Color3.fromRGB(60, 220, 180), Accent2 = Color3.fromRGB(150, 245, 220) },
	Violet = { Accent = Color3.fromRGB(180, 80, 255), Accent2 = Color3.fromRGB(220, 150, 255) },
}

function Library:SetTheme(name)
	local t = THEMES[name]
	if not t then return end
	Theme.Accent = t.Accent
	Theme.Accent2 = t.Accent2
end

function Library:GetThemes()
	local list = {}
	for k, _ in pairs(THEMES) do table.insert(list, k) end
	table.sort(list)
	return list
end

function Window:SetClickFx(cfg)
	cfg = cfg or {}
	if not cfg.Enabled then return end
	local gui = create("ScreenGui", {
		Name = "GuiLib_ClickFX",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 100,
		Parent = self.Gui,
	})
	local color = cfg.Color or Theme.Accent
	local size = cfg.Size or 80
	local dur = cfg.Duration or 0.65
	local style = cfg.Style or "Rings"

	UIS.InputBegan:Connect(function(input)
		if not isPointer(input) then return end
		local pos = UIS:GetMouseLocation()
		if input.UserInputType == Enum.UserInputType.Touch then
			pos = Vector2.new(input.Position.X, input.Position.Y + 36)
		end
		local c = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, pos.X, 0, pos.Y),
			Size = UDim2.fromOffset(10, 10),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = gui,
		}, { round(), stroke(color, 0.1, 3) })
		if style == "Pulse" then
			c.BackgroundColor3 = color
			c.BackgroundTransparency = 0.6
		end
		tween(c, dur, {
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
		})
		task.delay(dur + 0.05, function() c:Destroy() end)
	end)
end

function Window:Toast(text, duration)
	duration = duration or 2
	local t = create("TextLabel", {
		Size = UDim2.new(0, 220, 0, 42),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 20),
		BackgroundColor3 = Theme.Topbar,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		Parent = self.Gui,
	}, { round(), stroke(Theme.Accent, 0.4) })
	tween(t, 0.3, { Position = UDim2.new(0.5, 0, 1, -60) }, Enum.EasingStyle.Back)
	task.delay(duration, function()
		tween(t, 0.25, { Position = UDim2.new(0.5, 0, 1, 20) })
		task.wait(0.3)
		t:Destroy()
	end)
end