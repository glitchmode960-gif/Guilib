	Mint = { Accent = Color3.fromRGB(60, 220, 180) },
	Violet = { Accent = Color3.fromRGB(180, 80, 255) },
	Grey = { Accent = Color3.fromRGB(150, 150, 160) },
}

local function recolor(root, map)
	for _, obj in ipairs(root:GetDescendants()) do
		if not obj:GetAttribute("NoTheme") then
			pcall(function()
				if obj:IsA("GuiObject") then
					local n = map[obj.BackgroundColor3:ToHex()]; if n then obj.BackgroundColor3 = n end
				end
				if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
					local n = map[obj.TextColor3:ToHex()]; if n then obj.TextColor3 = n end
				end
				if obj:IsA("ScrollingFrame") then
					local n = map[obj.ScrollBarImageColor3:ToHex()]; if n then obj.ScrollBarImageColor3 = n end
				end
				if obj:IsA("UIStroke") then
					local n = map[obj.Color:ToHex()]; if n then obj.Color = n end
				end
				if obj:IsA("UIGradient") then
					local kps, changed = {}, false
					for _, kp in ipairs(obj.Color.Keypoints) do
						local n = map[kp.Value:ToHex()]
						if n then changed = true end
						table.insert(kps, ColorSequenceKeypoint.new(kp.Time, n or kp.Value))
					end
					if changed then obj.Color = ColorSequence.new(kps) end
				end
			end)
		end
	end
end

function Library:SetTheme(name)
	local t = THEMES[name]; if not t then return end
	local map = {}
	for _, k in ipairs(THEME_KEYS) do
		local new = t[k]
		if new and new ~= Theme[k] then map[Theme[k]:ToHex()] = new end
	end
	for _, k in ipairs(THEME_KEYS) do if t[k] then Theme[k] = t[k] end end
	for _, w in ipairs(Library._windows) do recolor(w.Gui, map) end
end

function Library:GetThemes()
	local l = {}
	for k in pairs(THEMES) do table.insert(l, k) end
	table.sort(l)
	return l
end

function Library:CloseAll()
	for _, w in ipairs(table.clone(Library._windows)) do w:Destroy() end
end

