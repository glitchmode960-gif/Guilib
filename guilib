	}, { corner(10), create("UIStroke", { Color = Theme.Stroke, Thickness = 2, Transparency = 0.4 }) })

	-- шапка
	local header = create("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, Parent = self.Main })
