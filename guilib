-- Горячая клавиша на любой элемент: опция Hotkey = Enum.KeyCode.X в конфиге элемента,
-- либо удержание строки мышью 0.8с (кнопка, тумблер, список). Привязки сохраняются в конфиг.
function Tab:_bindable(o)
	local win = self.Window
	local base = "hk_" .. tostring(o.Flag or o.Name or "item")
	local id, n = base, 1
	while win._hotkeys[id] do n += 1; id = base .. "_" .. n end
	local flag = "_" .. id
	local entry = { key = o.Hotkey }
	win._hotkeys[id] = entry

	local function setKey(k, silent)
		entry.key = k
		win:_setFlag(flag, k and k.Name or "", silent)
	end
	local obj = {}
	function obj:Get() return entry.key and entry.key.Name or "" end
	function obj:Set(v, s)
		local k
		if type(v) == "string" and v ~= "" then
			local ok, res = pcall(function() return Enum.KeyCode[v] end)
			if ok then k = res end
		end
		setKey(k, s)
	end
	win:_register(flag, obj, obj:Get())

	function entry.startBind()
		local name = tostring(o.Name or "элемент")
		win:Notify({ Title = "Горячая клавиша", Text = "Нажми клавишу для «" .. name .. "» (Esc — убрать)", Type = "info", Duration = 4 })
		local conn
		conn = UIS.InputBegan:Connect(function(i)
			if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
			conn:Disconnect()
			if i.KeyCode == Enum.KeyCode.Escape then
				setKey(nil)
				win:Notify({ Title = "Горячая клавиша", Text = "Привязка убрана", Type = "warn", Duration = 2 })
			else
				setKey(i.KeyCode)
				win:Notify({ Title = "Готово", Text = name .. " → " .. i.KeyCode.Name, Type = "success", Duration = 2 })
			end
		end)
		table.insert(win._conns, conn)
	end
	return entry
end

