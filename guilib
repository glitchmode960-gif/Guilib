		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, Parent = self.Page,
	})
	local t = label(wrap, title, UDim2.new(1, 0, 0, 24), UDim2.fromOffset(4, 0), 17)
