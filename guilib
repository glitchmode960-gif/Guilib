	}, { round() })
	create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Parent = marker })
	local hue = create("TextButton", {
		Text = "", AutoButtonColor = false, Size = UDim2.new(1, -24, 0, 14), Position = UDim2.fromOffset(12, 104),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = holder,
	}, { round() })
	create("UIGradient", {
		Parent = hue,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
		}),
	})
	local hM = create("Frame", {
		Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(h, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = hue,
	}, { round() })
	create("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.5, Thickness = 2, Parent = hM })
	local hexBox = create("TextBox", {
		Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 126), BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0, Text = "", PlaceholderText = "#RRGGBB", PlaceholderColor3 = Theme.SubText,
		TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13, ClearTextOnFocus = false, Parent = holder,
	}, { corner(8) })

	local function apply(silent)
		color = Color3.fromHSV(h, s, v)
		preview.BackgroundColor3 = color
		hexBox.Text = "#" .. hex(color)
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		marker.Position = UDim2.new(s, 0, 1 - v, 0)
		hM.Position = UDim2.new(h, 0, 0.5, 0)
		win:_setFlag(o.Flag, color, silent)
		if not silent then safe(o.Callback, color) end
	end
	-- строим обновление градиента насыщенности один раз при смене тона
	local function updateHueGradient()
		wg.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(h, 1, 1))
