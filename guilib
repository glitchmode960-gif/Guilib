function Tab:AddKeybind(o)
	local win = self.Window
	local key = o.Default or Enum.KeyCode.RightShift
	local listening = false

	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(1, -110, 1, 0), UDim2.fromOffset(14, 0))

	local badge = create("TextButton", {
		Size = UDim2.fromOffset(90, 30),
		Position = UDim2.new(1, -104, 0.5, -15),
		BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0,
		Text = key.Name,
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		AutoButtonColor = false,
		Parent = row,
	}, { corner(8), stroke(Theme.Stroke, 0.5) })

	local obj = {}
	local function setLabel()
		badge.Text = listening and "..." or key.Name
	end

	badge.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		setLabel()
		local conn
		conn = UIS.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if input.KeyCode == Enum.KeyCode.Escape then
				listening = false
				setLabel()
				conn:Disconnect()
				return
			end
			key = input.KeyCode
			listening = false
			setLabel()
			conn:Disconnect()
			if o.Flag then win.Flags[o.Flag] = key.Name end
			safe(o.Callback, key)
		end)
	end)

	win:_connect(UIS.InputBegan, function(input, processed)
		if processed then return end
		if input.KeyCode == key and o.Callback then
			safe(o.Callback, key)
		end
	end)

	function obj:Get() return key end
	function obj:Set(v)
		key = typeof(v) == "string" and (Enum.KeyCode[v] or key) or v
		setLabel()
	end
	if o.Flag then win.Flags[o.Flag] = key.Name end
	return obj
end

function Tab:AddColorPicker(o)
	local win = self.Window
	local color = o.Default or Theme.Accent
	local h, s, v = Color3.toHSV(color)
	local open = false

	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(1, -60, 0, ROW), UDim2.fromOffset(14, 0))

	local preview = create("Frame", {
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, -42, 0.5, -14),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = row,
	}, { corner(8), stroke(Color3.new(1, 1, 1), 0.6) })
	local header = clickArea(row, ROW)

	local holder = create("Frame", {
		Position = UDim2.fromOffset(0, ROW),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = row,
	})

	local sv = create("Frame", {
		Size = UDim2.new(1, -28, 0, 100),
		Position = UDim2.fromOffset(14, 6),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 0,
		Parent = holder,
	}, { corner(8) })

	local white = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = sv,
	}, { corner(8) })
	local wg = create("UIGradient", { Parent = white })
	wg.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(h, 1, 1))
	wg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})

	local black = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = sv,
	}, { corner(8) })
	local bg = create("UIGradient", { Parent = black, Rotation = 90 })
	bg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})

	local marker = create("Frame", {
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(s, 0, 1 - v, 0),
		BackgroundTransparency = 1,
		Parent = sv,
	}, { round(), stroke(Color3.new(1, 1, 1), 0, 2) })

	local hue = create("Frame", {
		Size = UDim2.new(1, -28, 0, 14),
		Position = UDim2.fromOffset(14, 114),
		BackgroundColor3 = Color3.fromRGB(255, 0, 0),
		BorderSizePixel = 0,
		Parent = holder,
	}, { round() })
	local hg = create("UIGradient", { Parent = hue })
	hg.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
		ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
		ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
		ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
		ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
	})
	local hMarker = create("Frame", {
		Size = UDim2.fromOffset(18, 18),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(h, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = hue,
	}, { round(), stroke(Color3.new(0, 0, 0), 0.5, 2) })

	local function apply(silent)
		color = Color3.fromHSV(h, s, v)
		preview.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		wg.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(h, 1, 1))
		marker.Position = UDim2.new(s, 0, 1 - v, 0)
		hMarker.Position = UDim2.new(h, 0, 0.5, 0)
		if o.Flag then win.Flags[o.Flag] = color end
		if not silent then safe(o.Callback, color) end
	end

	local dragSV, dragH = false, false
	local function handleSV(input)
		local px = (input.Position.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X
		local py = (input.Position.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y
		s = math.clamp(px, 0, 1)
		v = 1 - math.clamp(py, 0, 1)
		apply()
	end
	local function handleH(input)
		h = math.clamp((input.Position.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
		apply()
	end

	sv.InputBegan:Connect(function(input)
		if isPointer(input) then dragSV = true; handleSV(input) end
	end)
	hue.InputBegan:Connect(function(input)
		if isPointer(input) then dragH = true; handleH(input) end
	end)
	win:_connect(UIS.InputChanged, function(input)
		if not isMove(input) then return end
		if dragSV then handleSV(input) end
		if dragH then handleH(input) end
	end)
	win:_connect(UIS.InputEnded, function(input)
		if isPointer(input) then dragSV = false; dragH = false end
	end)

	header.MouseButton1Click:Connect(function()
		open = not open
		tween(row, 0.22, { Size = UDim2.new(1, 0, 0, open and (ROW + 140) or ROW) }, Enum.EasingStyle.Quint)
		holder.Size = UDim2.new(1, 0, 0, open and 140 or 0)
	end)

	local obj = {}
	function obj:Get() return color end
	function obj:Set(c)
		h, s, v = Color3.toHSV(c)
		apply(true)
	end
	apply(true)
	return obj
end

function Tab:AddProgressBar(o)
	local min, max = o.Min or 0, o.Max or 100
	local value = o.Default or min
	local row = newRow(self.Page, 60)
	label(row, o.Name, UDim2.new(1, -90, 0, 26), UDim2.fromOffset(14, 6))
	local valLabel = label(row, "", UDim2.new(0, 70, 0, 26), UDim2.new(1, -84, 0, 6))
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.TextColor3 = Theme.SubText

	local bar = create("Frame", {
		Size = UDim2.new(1, -28, 0, 10),
		Position = UDim2.fromOffset(14, 38),
		BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0,
		Parent = row,
	}, { round() })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = bar,
	}, { round(), gradient(0) })

	local obj = {}
	local function set(v)
		value = math.clamp(v, min, max)
		local a = (max - min > 0) and (value - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(a, 1)
		valLabel.Text = math.floor(a * 100) .. (o.Suffix or "%")
	end
	function obj:Set(v) set(v) end
	function obj:Get() return value end
	set(value)
	return obj
end

function Tab:AddStepper(o)
	local win = self.Window
	local min, max = o.Min or 0, o.Max or 10
	local value = o.Default or min
	local step = o.Increment or 1

	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(1, -160, 1, 0), UDim2.fromOffset(14, 0))

	local minus = create("TextButton", {
		Size = UDim2.fromOffset(34, 34),
		Position = UDim2.new(1, -110, 0.5, -17),
		BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0,
		Text = "−",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 20,
		AutoButtonColor = false,
		Parent = row,
	}, { corner(8) })

	local valLabel = create("TextLabel", {
		Size = UDim2.fromOffset(40, 34),
		Position = UDim2.new(1, -70, 0.5, -17),
		BackgroundTransparency = 1,
		Text = tostring(value),
		TextColor3 = Theme.Accent2,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		Parent = row,
	})

	local plus = create("TextButton", {
		Size = UDim2.fromOffset(34, 34),
		Position = UDim2.new(1, -44, 0.5, -17),
		BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0,
		Text = "+",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 20,
		AutoButtonColor = false,
		Parent = row,
	}, { corner(8) })

	local obj = {}
	local function set(v, silent)
		value = math.clamp(v, min, max)
		valLabel.Text = tostring(value)
		if o.Flag then win.Flags[o.Flag] = value end
		if not silent then safe(o.Callback, value) end
	end
	minus.MouseButton1Click:Connect(function() set(value - step) end)
	plus.MouseButton1Click:Connect(function() set(value + step) end)
	function obj:Get() return value end
	function obj:Set(v) set(v) end
	if o.Flag then win.Flags[o.Flag] = value end
	return obj
end

function Tab:AddRadioGroup(o)
	local win = self.Window
	local options = o.Options or {}
	local current = o.Default or options[1]

	local wrap = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Parent = self.Page,
	}, {
		corner(10),
		stroke(Theme.Stroke, 0.6),
		create("UIPadding", {
			PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12),
			PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
		}),
	})
	label(wrap, o.Name, UDim2.new(1, 0, 0, 22), nil)
	local holder = create("Frame", {
		Size = UDim2.new(1, 0, 0, 38),
		Position = UDim2.fromOffset(0, 26),
		BackgroundTransparency = 1,
		Parent = wrap,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		Parent = holder,
	})

	local btns = {}
	local function update()
		for _, d in ipairs(btns) do
			tween(d.Btn, 0.15, { BackgroundColor3 = d.Name == current and Theme.Accent or Theme.Hover })
		end
	end

	local obj = {}
	local function set(v, silent)
		current = v
		update()
		if o.Flag then win.Flags[o.Flag] = current end
		if not silent then safe(o.Callback, current) end
	end

	for _, opt in ipairs(options) do
		local b = create("TextButton", {
			Size = UDim2.fromOffset(90, 34),
			BackgroundColor3 = Theme.Hover,
			BorderSizePixel = 0,
			Text = tostring(opt),
			TextColor3 = Theme.Text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			AutoButtonColor = false,
			Parent = holder,
		}, { corner(8) })
		b.MouseButton1Click:Connect(function() set(opt) end)
		table.insert(btns, { Name = opt, Btn = b })
	end

	function obj:Get() return current end
	function obj:Set(v) set(v) end
	set(current, true)
	return obj
end

function Tab:AddMultiDropdown(o)
	local win = self.Window
	local options = o.Options or {}
	local selected = {}
	for _, v in ipairs(o.Default or {}) do selected[v] = true end
	local open = false

	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(0.5, -14, 0, ROW), UDim2.fromOffset(14, 0))
	local valLabel = label(row, "0 выбрано", UDim2.new(0.5, -14, 0, ROW), UDim2.new(0.5, 0, 0, 0))
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.TextColor3 = Theme.SubText
	local header = clickArea(row, ROW)

	local holder = create("Frame", {
		Position = UDim2.fromOffset(0, ROW),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = row,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 4),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = holder,
	})

	local btns = {}
	local function getList()
		local l = {}
		for _, opt in ipairs(options) do
			if selected[opt] then table.insert(l, opt) end
		end
		return l
	end
	local function update()
		for _, d in pairs(btns) do
			tween(d.Btn, 0.15, {
				BackgroundColor3 = selected[d.Name] and Theme.Accent or Theme.Hover
			})
		end
		valLabel.Text = #getList() .. " выбрано"
	end

	for _, opt in ipairs(options) do
		local b = create("TextButton", {
			Size = UDim2.new(1, -20, 0, 38),
			BackgroundColor3 = Theme.Hover,
			BorderSizePixel = 0,
			Text = tostring(opt),
			TextColor3 = Theme.Text,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			AutoButtonColor = false,
			Parent = holder,
		}, { corner(8) })
		b.MouseButton1Click:Connect(function()
			selected[opt] = not selected[opt] or nil
			update()
			if o.Flag then win.Flags[o.Flag] = getList() end
			safe(o.Callback, getList())
		end)
		btns[opt] = { Name = opt, Btn = b }
	end

	header.MouseButton1Click:Connect(function()
		open = not open
		tween(row, 0.2, { Size = UDim2.new(1, 0, 0, open and (ROW + #options * 42 + 6) or ROW) })
		holder.Size = UDim2.new(1, 0, 0, open and (#options * 42 + 6) or 0)
	end)

	local obj = {}
	function obj:Get() return getList() end
	function obj:Set(list)
		selected = {}
		for _, v in ipairs(list) do selected[v] = true end
		update()
	end
	update()
	if o.Flag then win.Flags[o.Flag] = getList() end
	return obj
end

function Tab:AddDivider()
	local wrap = create("Frame", {
		Size = UDim2.new(1, 0, 0, 9),
		BackgroundTransparency = 1,
		Parent = self.Page,
	})
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Theme.Stroke,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		Parent = wrap,
	})
end

function Tab:AddLoader(o)
	local row = newRow(self.Page)
	local ring = create("Frame", {
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.fromOffset(14, 11),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = row,
	}, { round() })
	create("Frame", {
		Size = UDim2.fromOffset(16, 16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Parent = ring,
	}, { round() })

	label(row, o.Name or "Загрузка...", UDim2.new(1, -50, 1, 0), UDim2.fromOffset(48, 0))

	local spinning = true
	task.spawn(function()
		while spinning and ring.Parent do
			ring.Rotation = (ring.Rotation + 8) % 360
			RunService.Heartbeat:Wait()
		end
	end)

	return { Stop = function() spinning = false end }
end

function Tab:AddParagraph(o)
	local row = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Parent = self.Page,
	}, {
		corner(10),
		stroke(Theme.Stroke, 0.6),
		create("UIPadding", {
			PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
		}),
	})
	local t = label(row, o.Title or "", UDim2.new(1, 0, 0, 0), nil, 15)
	t.Font = Enum.Font.GothamBold
	t.AutomaticSize = Enum.AutomaticSize.Y
	t.TextWrapped = true
	t.TextTruncate = Enum.TextTruncate.None

	local c = label(row, o.Content or "", UDim2.new(1, 0, 0, 0), UDim2.fromOffset(0, 22), 13)
	c.AutomaticSize = Enum.AutomaticSize.Y
	c.TextWrapped = true
	c.TextColor3 = Theme.SubText
	c.TextTruncate = Enum.TextTruncate.None
end

