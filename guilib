local function dismiss(note)
	if note and note.Parent and not note:GetAttribute("Closing") then
		note:SetAttribute("Closing", true)
		tween(note, 0.22, { GroupTransparency = 1 })
		task.delay(0.25, function() if note then note:Destroy() end end)
	end
end

function Window:_limitNotes()
	local list = {}
	for _, c in ipairs(self.Notes:GetChildren()) do
		if c:IsA("CanvasGroup") and not c:GetAttribute("Closing") then table.insert(list, c) end
	end
	while #list > MAX_NOTES do dismiss(table.remove(list, 1)) end
end

