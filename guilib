local activeTip

local function hideTip()
	if activeTip then
		activeTip.conn:Disconnect()
		activeTip.frame:Destroy()
		activeTip = nil
	end
end

local function showTip(gui, text, fixedPos)
	hideTip()
	local f = create("Frame", {
		Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundColor3 = Theme.Topbar,
		BackgroundTransparency = 0.05, BorderSizePixel = 0, ZIndex = 200, Parent = gui,
	}, { corner(6), stroke(), pad(6, 6, 10, 10), create("UISizeConstraint", { MaxSize = Vector2.new(280, 400) }) })
	create("TextLabel", {
		Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
		Text = text, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
	})
	local function place()
		local p = fixedPos or UIS:GetMouseLocation()
		local v = workspace.CurrentCamera.ViewportSize
		local x = math.clamp(p.X + 14, 6, math.max(6, v.X - f.AbsoluteSize.X - 6))
		local y = math.clamp(p.Y + 18, 6, math.max(6, v.Y - f.AbsoluteSize.Y - 6))
		f.Position = UDim2.fromOffset(x, y)
	end
	place()
	activeTip = { frame = f, conn = RunService.RenderStepped:Connect(place) }
end

local function attachTip(obj, text)
	if not text then return end
	local tok = 0
	obj.MouseEnter:Connect(function()
		tok += 1
		local my = tok
		task.delay(0.45, function()
			if my == tok and obj.Parent then
				local g = obj:FindFirstAncestorWhichIsA("ScreenGui")
				if g then showTip(g, text) end
			end
		end)
	end)
	obj.MouseLeave:Connect(function() tok += 1; hideTip() end)
end

