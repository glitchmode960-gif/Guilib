function Library:CreateWindow(opts)
	if type(opts) == "string" then opts = { Title = opts } end
	opts = opts or {}
	local self = setmetatable({}, Window)
	self._conns, self._tabs, self._setters = {}, {}, {}
	self.Flags = {}; self.Open = true; self.Minimized = false
	self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
	self.ConfigName = opts.ConfigName or "default"
	self.CurrentTheme = opts.Theme or "Delta"

	if THEMES[self.CurrentTheme] then
		for k, v in pairs(THEMES[self.CurrentTheme]) do Theme[k] = v end
	end

	local title = opts.Title or "Window"
	local cam = workspace.CurrentCamera
	local function fullSize() local v = cam.ViewportSize
		return Vector2.new(math.min(560, v.X * 0.94), math.min(420, v.Y * 0.78)) end
	self._size = fullSize()

	self.Gui = create("ScreenGui", {
		Name = "GuiLib_" .. tostring(math.random(1000, 9999)),
		ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	mountGui(self.Gui)

	-- Main — БЕЗ прозрачности, чистый тёмный фон как в Delta
	self.Main = create("CanvasGroup", {
		Size = UDim2.fromOffset(self._size.X, self._size.Y),
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Parent = self.Gui,
	}, { corner(20) })
	self.Scale = create("UIScale", { Parent = self.Main })

	-- Верхняя панель — минималистичная, без линии
	local header = create("Frame", {
		Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = Theme.Topbar,
		BorderSizePixel = 0, Parent = self.Main,
	}, { corner(20) })
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -16),
		BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0, Parent = header,
	})

	local tLbl = label(header, title, UDim2.new(1, -100, 0, 24), UDim2.fromOffset(20, opts.Subtitle and 6 or 14), 18)
	tLbl.Font = Enum.Font.GothamBold
	if opts.Subtitle then
		local s = label(header, opts.Subtitle, UDim2.new(1, -100, 0, 16), UDim2.fromOffset(20, 30), 12)
		s.TextColor3 = Theme.SubText
	end

	-- Кнопки — кружки, как в Delta
	local function hBtn(t, x, cb)
		local b = create("TextButton", {
			Size = UDim2.fromOffset(34, 34), Position = UDim2.new(1, x, 0.5, -17),
			BackgroundColor3 = Theme.Element, Text = t, TextColor3 = Theme.SubText,
			Font = Enum.Font.GothamBold, TextSize = 15, AutoButtonColor = false, Parent = header,
		}, { round() })
		b.MouseEnter:Connect(function() tween(b, 0.15, { BackgroundColor3 = Theme.Hover, TextColor3 = Theme.Text }) end)
		b.MouseLeave:Connect(function() tween(b, 0.15, { BackgroundColor3 = Theme.Element, TextColor3 = Theme.SubText }) end)
		b.MouseButton1Click:Connect(cb)
		return b
	end
	hBtn("✕", -48, function() self:Destroy() end)
	hBtn("−", -90, function() self:SetMinimized(not self.Minimized) end)

	-- Body
	self.Body = create("Frame", {
		Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52),
		BackgroundTransparency = 1, Parent = self.Main,
	})

	-- TabBar — пилюли, как в Delta
	self.TabBar = create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, Parent = self.Body,
	})
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder, Parent = self.TabBar })
	create("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), Parent = self.TabBar })

	self.Pages = create("Frame", {
		Size = UDim2.new(1, 0, 1, -46), Position = UDim2.fromOffset(0, 46),
		BackgroundTransparency = 1, Parent = self.Body,
	})

	-- Notifications
	self.Notes = create("Frame", {
		Size = UDim2.fromOffset(math.min(320, cam.ViewportSize.X * 0.9), 400),
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 60),
		BackgroundTransparency = 1, Parent = self.Gui,
	})
	create("UIListLayout", { Padding = UDim.new(0, 8),
		HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = self.Notes })

	-- FAB — круглая, акцентная, как у Delta
	self.Fab = create("TextButton", {
		Size = UDim2.fromOffset(56, 56), Position = UDim2.new(0, 16, 0.45, 0),
		BackgroundColor3 = Theme.Accent, Text = title:sub(1, 1):upper(),
		TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 26,
		AutoButtonColor = false, Parent = self.Gui,
	}, { round() })

	self:_drag(header, self.Main)
	self:_drag(self.Fab, self.Fab, function() self:SetOpen(not self.Open) end)
	self:_connect(UIS.InputBegan, function(i, p)
		if not p and i.KeyCode == self.ToggleKey then self:SetOpen(not self.Open) end
	end)
	self:_connect(cam:GetPropertyChangedSignal("ViewportSize"), function()
		self._size = fullSize()
		self.Main.Size = UDim2.fromOffset(self._size.X, self.Minimized and 52 or self._size.Y)
		self.Notes.Size = UDim2.fromOffset(math.min(320, cam.ViewportSize.X * 0.9), 400)
	end)

	self.Main.GroupTransparency = 1; self.Scale.Scale = 0.92
	tween(self.Main, 0.28, { GroupTransparency = 0 })
	tween(self.Scale, 0.32, { Scale = 1 }, Enum.EasingStyle.Quint)

	return self
end

function Window:_connect(sig, fn) local c = sig:Connect(fn); table.insert(self._conns, c); return c end
function Window:_drag(handle, target, onTap)
	local dragging, moved, ds, sp = false, false, nil, nil
	handle.InputBegan:Connect(function(i)
		if not isPointer(i) then return end
		dragging, moved = true, false; ds, sp = i.Position, target.Position
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then
				dragging = false; if not moved and onTap then onTap() end
			end
		end)
	end)
	self:_connect(UIS.InputChanged, function(i)
		if dragging and isMove(i) then
			local d = i.Position - ds; if d.Magnitude > 6 then moved = true end
			if moved or not onTap then
				target.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
			end
		end
	end)
end

function Window:SetOpen(v)
	self.Open = v
	if v then
		self.Main.Visible = true
		tween(self.Main, 0.22, { GroupTransparency = 0 })
		tween(self.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Quint)
	else
		tween(self.Main, 0.15, { GroupTransparency = 1 })
		tween(self.Scale, 0.15, { Scale = 0.92 })
		task.delay(0.16, function() if not self.Open then self.Main.Visible = false end end)
	end
end

function Window:SetMinimized(v)
	self.Minimized = v
	tween(self.Main, 0.28, { Size = UDim2.fromOffset(self._size.X, v and 52 or self._size.Y) }, Enum.EasingStyle.Quint)
end

function Window:Destroy()
	for _, c in ipairs(self._conns) do c:Disconnect() end
	table.clear(self._conns); self.Gui:Destroy()
end

function Window:SelectTab(tab)
	for _, t in ipairs(self._tabs) do
		local on = t == tab
		t.Page.Visible = on
		tween(t.Button, 0.2, {
			BackgroundColor3 = on and Theme.Accent or Theme.Element,
			TextColor3 = on and Color3.new(1, 1, 1) or Theme.SubText,
		})
	end
end

function Window:CreateTab(name)
	-- Пилюля как в Delta
	local button = create("TextButton", {
		Size = UDim2.fromOffset(0, 34), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Text = name,
		TextColor3 = Theme.SubText, Font = Enum.Font.GothamBold, TextSize = 14,
		AutoButtonColor = false, LayoutOrder = #self._tabs, Parent = self.TabBar,
	}, { round(), create("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }) })

	local page = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false, Parent = self.Pages,
	})
	create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })
	create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 16),
		PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), Parent = page })

	local tab = setmetatable({ Window = self, Page = page, Button = button, Name = name }, Tab)
	table.insert(self._tabs, tab)
	button.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
