		color = Color3.fromHSV(h, s, v)
		preview.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		marker.Position = UDim2.new(s, 0, 1 - v, 0)
		hM.Position = UDim2.new(h, 0, 0.5, 0)
		win:_setFlag(o.Flag, color, silent)
		if not silent then safe(o.Callback, color) end
	end
	-- строим обновление градиента насыщенности один раз при смене тона
	local function updateHueGradient()
		wg.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(h, 1, 1))
	end
	updateHueGradient()

	local dSV, dH = false, false
	local function hSV(i)
		local p = screenPos(i)
		s = math.clamp((p.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
		v = 1 - math.clamp((p.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		apply()
	end
	local function hH(i)
		h = math.clamp((i.Position.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
		updateHueGradient(); apply()
	end
	local function lock(on) page.ScrollingEnabled = not on end
	sv.InputBegan:Connect(function(i) if isPointer(i) then dSV = true; lock(true); hSV(i) end end)
	hue.InputBegan:Connect(function(i) if isPointer(i) then dH = true; lock(true); hH(i) end end)
	win:_connect(UIS.InputChanged, function(i)
		if not isMove(i) then return end
		if dSV then hSV(i) end
		if dH then hH(i) end
	end)
	win:_connect(UIS.InputEnded, function(i)
		if isPointer(i) and (dSV or dH) then dSV, dH = false, false; lock(false) end
	end)
	header.MouseButton1Click:Connect(function()
		open = not open
		tween(row, 0.22, { Size = UDim2.new(1, 0, 0, open and (ROW + 160) or ROW) }, Enum.EasingStyle.Quint)
	end)
	local obj = {}
	function obj:Get() return color end
	function obj:Set(c, silent)
		if typeof(c) == "Color3" then h, s, v = Color3.toHSV(c); updateHueGradient(); apply(silent) end
	end
	apply(true); win:_register(o.Flag, obj, color)
	return obj
end

