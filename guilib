function Window:DeleteConfig(name)
	if typeof(delfile) ~= "function" or typeof(isfile) ~= "function" then return false end
	local f = "GuiLib_" .. tostring(name) .. ".json"
	if not isfile(f) then return false end
	return (pcall(delfile, f))
end

Window.GetConfigs = Window.ListConfigs

-- загрузить профиль, выбранный для автозагрузки (вызывай в конце скрипта, когда все элементы созданы)
function Window:AutoLoad()
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" or not isfile(self._autoFile) then return false end
	local ok, name = pcall(readfile, self._autoFile)
	if ok and type(name) == "string" and name ~= "" then
		self.ConfigName = name
		return self:LoadConfig(name)
	end
	return false
end

-- готовый блок «Сохранить / Загрузить / Удалить профиль» с выпадающим списком
function Window:CreateConfigManager(tab)
	tab:AddSection("Профили конфигов")
	local drop
	local function refresh()
		if drop then drop:Refresh(self:ListConfigs()) end
	end
	tab:AddTextbox({
		Name = "Имя профиля", Default = self.ConfigName or "default", Placeholder = "my_config",
		Callback = function(n) if n ~= "" then self.ConfigName = n end end,
	})
	drop = tab:AddDropdown({
		Name = "Профили", Options = self:ListConfigs(),
		Callback = function(n) if n then self.ConfigName = n end end,
	})
	tab:AddButton({ Name = "Сохранить профиль", Description = "Все значения элементов и горячие клавиши", Callback = function()
		local ok = self:SaveConfig()
		refresh()
		self:Notify({
			Title = ok and "Сохранено" or "Ошибка", Type = ok and "success" or "error", Duration = 2.5,
			Text = ok and ("Профиль: " .. self.ConfigName) or "writefile недоступен",
		})
	end })
	tab:AddButton({ Name = "Загрузить профиль", Callback = function()
		local ok = self:LoadConfig()
		self:Notify({
			Title = ok and "Загружено" or "Ошибка", Type = ok and "success" or "error", Duration = 2.5,
			Text = ok and ("Профиль: " .. self.ConfigName) or "Файл не найден",
		})
	end })
	tab:AddButton({ Name = "Удалить профиль", Callback = function()
		local name = self.ConfigName
		self:Confirm("Удалить профиль?", "Профиль «" .. name .. "» будет удалён без возможности восстановления.", function()
			local ok = self:DeleteConfig(name)
			refresh()
			self:Notify({
				Title = ok and "Удалено" or "Ошибка", Type = ok and "success" or "error", Duration = 2.5,
				Text = ok and name or "Не удалось удалить (delfile недоступен?)",
			})
		end)
	end })

	tab:AddButton({ Name = "Скопировать конфиг", Description = "В буфер обмена — можно поделиться с другом", Callback = function()
		local s, copy = self:ExportConfig(), setclipboard or toclipboard
		if s and copy then
			copy(s)
			self:Notify({ Title = "Скопировано", Text = "Конфиг в буфере обмена", Type = "success", Duration = 2 })
		else
			self:Notify({ Title = "Ошибка", Text = "Буфер обмена недоступен", Type = "error", Duration = 3 })
		end
	end })
	local importBox
	importBox = tab:AddTextbox({ Name = "Вставить конфиг", Placeholder = "вставь JSON и нажми Enter", Finished = true, Callback = function(text)
		if text == "" then return end
		local ok = self:ImportConfig(text)
		importBox:Set("", true)
		self:Notify({ Title = ok and "Импорт" or "Ошибка", Type = ok and "success" or "error", Duration = 2.5,
			Text = ok and "Значения применены" or "Не удалось прочитать конфиг" })
	end })

	local cur
	if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(self._autoFile) then
		local ok, v = pcall(readfile, self._autoFile)
		if ok then cur = v end
	end
	tab:AddToggle({
		Name = "Автозагрузка профиля", Description = "Окно само применит выбранный профиль при запуске (win:AutoLoad())",
		Default = cur ~= nil and cur == self.ConfigName,
		Callback = function(v)
			if typeof(writefile) ~= "function" then return end
			if v then
				pcall(writefile, self._autoFile, self.ConfigName)
			elseif typeof(delfile) == "function" then
				pcall(delfile, self._autoFile)
			else
				pcall(writefile, self._autoFile, "")
			end
		end,
	})
	tab:AddButton({ Name = "Обновить список профилей", Callback = refresh })
end

