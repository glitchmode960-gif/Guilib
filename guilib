function Tab:AddDropdown(o)
	local win = self.Window
	local options = o.Options or {}
	local current = o.Default
	local open = false
	local row = newRow(self.Page)
	label(row, o.Name or "Dropdown", UDim2.new(0.5, -16, 0, ROW), UDim2.fromOffset(16, 0), 15).Font = Enum.Font.GothamMedium
	local sel = label(row, "", UDim2.new(0.4, -30, 0, ROW), UDim2.new(0.5, 0, 0, 0), 14)
	sel.TextXAlignment = Enum.TextXAlignment.Right; sel.TextColor3 = Theme.Accent; sel.Font = Enum.Font.GothamBold
	local arrow = create("TextLabel", {
		Size = UDim2.fromOffset(24, ROW), Position = UDim2.new(1, -30, 0, 0), BackgroundTransparency = 1,
		Text = "▾", TextColor3 = Theme.SubText, Font = Enum.Font.GothamBold, TextSize = 14, Parent = row,
	})
	local hk = self:_bindable(o)
	local header = clickArea(row, ROW, { Tooltip = o.Tooltip, OnHold = hk.startBind })
	local list = create("Frame", {
		Position = UDim2.fromOffset(0, ROW), Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, Parent = row,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder, Parent = list,
	})
	local obj, buttons = {}, {}
	local searchBox, shown = nil, 0

	local function bodyHeight() return (searchBox and 32 or 0) + shown * OPT_STEP + 8 end
	local function setOpen(v)
		open = v
		tween(row, 0.2, { Size = UDim2.new(1, 0, 0, v and (ROW + bodyHeight()) or ROW) }, Enum.EasingStyle.Quint)
		tween(arrow, 0.2, { Rotation = v and 180 or 0 })
	end
	local function select(opt, silent)
		current = opt; sel.Text = tostring(opt == nil and "-" or opt)
		win:_setFlag(o.Flag, opt, silent)
		for val, b in pairs(buttons) do tween(b, 0.15, { BackgroundColor3 = val == opt and Theme.Accent or Theme.Hover }) end
		if not silent then safe(o.Callback, opt) end
	end
	-- поиск по пунктам (появляется, если пунктов больше 7)
	local function applyFilter(q)
		q = string.lower(q or "")
		shown = 0
		for _, opt in ipairs(options) do
			local b = buttons[opt]
			if b then
				local ok = q == "" or string.find(string.lower(tostring(opt)), q, 1, true) ~= nil
				b.Visible = ok
				if ok then shown += 1 end
			end
		end
		if open then setOpen(true) end
	end
	local function build()
		for _, b in pairs(buttons) do b:Destroy() end
		table.clear(buttons)
		if searchBox then searchBox:Destroy(); searchBox = nil end
		if #options > 7 then
			searchBox = create("TextBox", {
				Size = UDim2.new(1, -12, 0, 28), BackgroundColor3 = Theme.Hover, BorderSizePixel = 0, Text = "",
				PlaceholderText = "Поиск...", PlaceholderColor3 = Theme.SubText, TextColor3 = Theme.Text,
				Font = Enum.Font.Gotham, TextSize = 13, ClearTextOnFocus = false, LayoutOrder = 0, Parent = list,
			}, { corner(8), create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) })
			searchBox:GetPropertyChangedSignal("Text"):Connect(function() applyFilter(searchBox.Text) end)
		end
		for idx, opt in ipairs(options) do
			local b = create("TextButton", {
				Size = UDim2.new(1, -12, 0, OPT_H), BackgroundColor3 = Theme.Hover, BorderSizePixel = 0,
				Text = tostring(opt), TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium,
				TextSize = 14, AutoButtonColor = false, LayoutOrder = idx, Parent = list,
			}, { corner(10) })
			fx(b, nil)
			b.MouseButton1Click:Connect(function()
				select(opt)
				if searchBox then searchBox.Text = "" end
				setOpen(false)
			end)
			buttons[opt] = b
		end
		shown = #options
	end
	onClick(header, function() setOpen(not open) end)
	hk.action = function() -- горячая клавиша: следующий пункт списка
		if #options == 0 then return end
		local idx = 0
		for k, v in ipairs(options) do if v == current then idx = k; break end end
		select(options[idx % #options + 1])
	end
	function obj:Get() return current end
	function obj:Set(v, s) select(v, s) end
	function obj:Refresh(newOpts) options = newOpts; build(); select(current, true); if open then setOpen(true) end end
	build(); select(current, true); win:_register(o.Flag, obj, current)
	return obj
end

