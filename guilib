	local row = newRow(self.Page, 50)
	label(row, o.Name or "Progress", UDim2.new(1, -90, 0, 20), UDim2.fromOffset(12, 6), 15).Font = Enum.Font.GothamMedium
	local vl = label(row, "", UDim2.new(0, 70, 0, 20), UDim2.new(1, -82, 0, 6), 14)
	vl.TextXAlignment = Enum.TextXAlignment.Right; vl.TextColor3 = Theme.Accent; vl.Font = Enum.Font.GothamBold
	local bar = create("Frame", {
		Size = UDim2.new(1, -24, 0, 6), Position = UDim2.fromOffset(12, 34),
		BackgroundColor3 = Theme.Hover, BorderSizePixel = 0, Parent = row,
	}, { round() })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = bar,
	}, { round() })
	local st = { val = value }
	local function render(x)
		local a = (max - min > 0) and (x - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(a, 1)
		vl.Text = math.floor(a * 100 + 0.5) .. (o.Suffix or "%")
	end
	local obj = {}
	function obj:Set(x)
		value = math.clamp(x, min, max)
		animNumber(st, value, 0.35, render) -- плавное докручивание значения
	end
	function obj:Get() return value end
	snapNumber(st, value, render)
	return obj
end

-- кольцо-спиннер без внешних картинок: SetActive(bool) включает/выключает вращение
function Tab:AddLoader(o)
	o = o or {}
	local row = newRow(self.Page)
	local ring = create("Frame", {
		Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(12, 9),
		BackgroundTransparency = 1, BorderSizePixel = 0, Parent = row,
	}, { round() })
	local st = create("UIStroke", { Color = Theme.Accent, Thickness = 3, Parent = ring })
	create("UIGradient", {
		Parent = st, Rotation = 0,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 1), NumberSequenceKeypoint.new(1, 1) }),
	})
	local lbl = label(row, o.Name or "Загрузка...", UDim2.new(1, -50, 1, 0), UDim2.fromOffset(44, 0), 15)
	lbl.Font = Enum.Font.GothamMedium
	local active = o.Active ~= false
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not ring.Parent then conn:Disconnect(); return end
		if active then ring.Rotation = (ring.Rotation + 360 * dt) % 360 end
	end)
	table.insert(self.Window._conns, conn)
	local obj = {}
	function obj:SetActive(on)
		active = on and true or false
		tween(st, 0.2, { Transparency = active and 0 or 0.7 })
	end
	function obj:Start() obj:SetActive(true) end
	function obj:Stop() obj:SetActive(false) end
	function obj:SetText(t) lbl.Text = t end
	obj:SetActive(active)
	return obj
end

