local function tint(btn, c)
	for _, d in ipairs(btn:GetDescendants()) do
		if d:IsA("UIStroke") then d.Color = c
		elseif d:IsA("Frame") and d.BackgroundTransparency < 1 then d.BackgroundColor3 = c end
	end
end

function Library:CreateWindow(opts)
	if type(opts) == "string" then opts = { Title = opts } end
	opts = opts or {}
	local self = setmetatable({}, Window)
	self._conns, self._tabs, self._setters, self._hotkeys, self._groups = {}, {}, {}, {}, {}
	self.Flags = {}; self.Open = true; self.Minimized = false; self.Maximized = false
	self.UserScale = 1; self._locked = false
	self.ConfigName = opts.ConfigName or "default"
	self.AutoSave = opts.AutoSave or false
	self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
	self.SaveGeometryEnabled = opts.SaveGeometry ~= false

	local title = opts.Title or "Window"
	local safeTitle = (tostring(title):gsub("[^%w_]", "_"))
	self._geoFile = "GuiLib_win_" .. safeTitle .. ".json"
	self._autoFile = "GuiLib_auto_" .. safeTitle .. ".txt"

	local cam = workspace.CurrentCamera
	local function fullSize()
		local v = cam.ViewportSize
		if self.Maximized then return Vector2.new(v.X * 0.96, v.Y * 0.9) end
		if self._customSize then
			return Vector2.new(math.clamp(self._customSize.X, 340, math.max(340, v.X * 0.98)), math.clamp(self._customSize.Y, 220, math.max(220, v.Y * 0.95)))
		end
		return Vector2.new(math.min(640, v.X * 0.94), math.min(440, v.Y * 0.78))
	end
	local function sbWidth() return math.clamp(math.floor(cam.ViewportSize.X * 0.24), 90, 150) end
	self._fullSize = fullSize
	self._size = fullSize()

	self.Gui = create("ScreenGui", {
		Name = "GuiLib_" .. tostring(math.random(1000, 9999)),
		ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	mountGui(self.Gui)
	table.insert(Library._windows, self)

	self.Main = create("CanvasGroup", {
		Size = UDim2.fromOffset(self._size.X, self._size.Y),
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Theme.Background, BackgroundTransparency = Theme.GlassAlpha,
		BorderSizePixel = 0, Parent = self.Gui,
	}, { corner(10) })
	self.Scale = create("UIScale", { Parent = self.Main })

	do -- картинка под стеклом (по умолчанию встроенный арт)
		local img, ratio = resolveBackground(opts.Background)
		if img then
			local kids
			if ratio then
				kids = { create("UIAspectRatioConstraint", {
					AspectRatio = ratio, AspectType = Enum.AspectType.ScaleWithParentSize, DominantAxis = Enum.DominantAxis.Height,
				}) }
			end
			self.BgImage = create("ImageLabel", {
				AnchorPoint = Vector2.new(1, 1), Position = ratio and UDim2.new(1, -4, 1, 0) or UDim2.fromScale(1, 1),
				Size = ratio and UDim2.fromScale(0, 1) or UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = img,
				ImageTransparency = opts.BackgroundTransparency or 0.78,
				ScaleType = ratio and Enum.ScaleType.Fit or Enum.ScaleType.Crop, Parent = self.Main,
			}, kids)
			self.BgImage:SetAttribute("NoTheme", true)
		end
	end
	self.BorderStroke = create("UIStroke", { Color = Theme.Stroke, Thickness = 2, Transparency = 0.4 })
	create("Frame", { -- рамка окна
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 20, Parent = self.Main,
	}, { corner(10), self.BorderStroke })

	-- шапка
	local header = create("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = self.Main })
	self.HeaderLine = create("Frame", {
		Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = Theme.Stroke,
		BackgroundTransparency = 0.55, BorderSizePixel = 0, Parent = header,
