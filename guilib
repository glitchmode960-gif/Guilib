		Size = UDim2.new(1, -32, 0, 10), Position = UDim2.fromOffset(16, 48),
		BackgroundColor3 = Theme.Hover, BorderSizePixel = 0, Parent = row,
	}, { round() })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = bar,
	}, { round() })
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(22, 22), Position = UDim2.fromScale(1, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = fill,
	}, { round() })
	local hit = create("Frame", {
		Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 28),
		BackgroundTransparency = 1, Active = true, Parent = row,
	})
	local obj = {}
	local function set(v, silent)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = math.clamp(math.floor(v * 10000 + 0.5) / 10000, min, max); value = v
		win:_setFlag(o.Flag, v, silent)
		vl.Text = tostring(v) .. (o.Suffix or "")
		fill.Size = UDim2.fromScale((max - min > 0) and (v - min) / (max - min) or 0, 1)
		if not silent then safe(o.Callback, v) end
	end
	local function fromInput(i)
		set(min + (max - min) * math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
	end
	local drag = false
	hit.InputBegan:Connect(function(i) if isPointer(i) then drag = true; page.ScrollingEnabled = false; fromInput(i) end end)
	win:_connect(UIS.InputChanged, function(i) if drag and isMove(i) then fromInput(i) end end)
	win:_connect(UIS.InputEnded, function(i) if drag and isPointer(i) then drag = false; page.ScrollingEnabled = true end end)
	function obj:Set(v, s) set(v, s) end
	function obj:Get() return value end
	set(value, true); win:_register(o.Flag, obj, value)
	return obj
