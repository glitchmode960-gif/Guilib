function Window:SetClickFx(cfg)
	cfg = cfg or {}
	if not cfg.Enabled then return end
	local gui = create("ScreenGui", { Name = "GuiLib_ClickFX", ResetOnSpawn = false,
		IgnoreGuiInset = true, DisplayOrder = 100, Parent = self.Gui })
	local color = cfg.Color or Theme.Accent
	local size = cfg.Size or 80
	local dur = cfg.Duration or 0.65
	UIS.InputBegan:Connect(function(i)
		if not isPointer(i) then return end
		local pos = UIS:GetMouseLocation()
		if i.UserInputType == Enum.UserInputType.Touch then pos = Vector2.new(i.Position.X, i.Position.Y + 36) end
		local c = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, pos.X, 0, pos.Y),
			Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = gui },
			{ round(), stroke(color, 0.1, 3) })
		tween(c, dur, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
		task.delay(dur + 0.05, function() c:Destroy() end)
	end)
end

function Window:Toast(text, duration)
	duration = duration or 2
	local t = create("TextLabel", { Size = UDim2.new(0, 240, 0, 44), AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 20), BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0,
		Text = text, TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 14, Parent = self.Gui },
		{ round() })
	tween(t, 0.3, { Position = UDim2.new(0.5, 0, 1, -60) }, Enum.EasingStyle.Quint)
	task.delay(duration, function()
		tween(t, 0.25, { Position = UDim2.new(0.5, 0, 1, 20) }); task.wait(0.3); t:Destroy()
	end)
end

