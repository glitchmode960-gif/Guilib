-- ============================================================
function Library:SetTheme(name)
	local t = THEMES[name]; if not t then return end
	local old = {}
	for k, v in pairs(Theme) do old[k] = v end
	for k, v in pairs(t) do Theme[k] = v end
	for _, gui in ipairs(CoreGui:GetChildren()) do
		if gui.Name:sub(1, 7) == "GuiLib_" then
			for _, obj in ipairs(gui:GetDescendants()) do
				pcall(function()
					if obj:IsA("UIStroke") then
						for k, v in pairs(old) do if obj.Color == v then obj.Color = Theme[k]; break end end
					elseif obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("CanvasGroup") or obj:IsA("ScrollingFrame") then
						for k, v in pairs(old) do if obj.BackgroundColor3 == v then obj.BackgroundColor3 = Theme[k]; break end end
					elseif obj:IsA("TextLabel") or obj:IsA("TextBox") then
						for k, v in pairs(old) do
							if obj.TextColor3 == v then obj.TextColor3 = Theme[k]; break end
							if obj.PlaceholderColor3 == v then obj.PlaceholderColor3 = Theme[k]; break end
						end
					elseif obj:IsA("UIGradient") then
						local cs = obj.Color
						if cs and cs.Keypoints then
							local kps = {}
							for _, kp in ipairs(cs.Keypoints) do
								local col = kp.Value
								for k, v in pairs(old) do if col == v then col = Theme[k]; break end end
								table.insert(kps, ColorSequenceKeypoint.new(kp.Time, col))
							end
							if #kps > 0 then obj.Color = ColorSequence.new(kps) end
						end
					end
				end)
			end
		end
	end
end

function Library:GetThemes()
	local l = {}; for k, _ in pairs(THEMES) do table.insert(l, k) end; table.sort(l); return l
end

function Library:CloseAll()
	for _, gui in ipairs(CoreGui:GetChildren()) do
		if gui.Name:sub(1, 7) == "GuiLib_" then gui:Destroy() end
	end
end

