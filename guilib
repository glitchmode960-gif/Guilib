		if list then list:Refresh(names) end
	end
	tab:AddTextbox({
		Name = "Имя", Default = self.ConfigName or "default", Placeholder = "my_config",
		Callback = function(n) if n ~= "" then self.ConfigName = n end end,
	})
	list = tab:AddDropdown({
		Name = "Сохранённые", Options = self:ListConfigs(),
		Callback = function(n) if n then self.ConfigName = n end end,
	})
	tab:AddButton({ Name = "Сохранить", Callback = function()
		local ok = self:SaveConfig()
		refresh()
		self:Notify({
			Title = ok and "Успех" or "Ошибка", Type = ok and "success" or "error",
			Text = ok and ("Сохранено: " .. self.ConfigName) or "writefile недоступен",
		})
	end })
	tab:AddButton({ Name = "Загрузить", Callback = function()
		local ok = self:LoadConfig()
		self:Notify({
			Title = ok and "Успех" or "Ошибка", Type = ok and "success" or "error",
			Text = ok and ("Загружено: " .. self.ConfigName) or "Файл не найден",
		})
	end })
	tab:AddToggle({ Name = "Автосохранение", Default = self.AutoSave, Callback = function(v) self.AutoSave = v end })
	refresh()
end

function Library:AddAutoTabs(win)
	-- Темы
	local tabT = win:CreateTab("Темы")
	tabT:AddSectionInfo("Персонализация", "Тема и цвет акцента")
	tabT:AddDropdown({
		Name = "Тема", Options = Library:GetThemes(), Default = "Fluent", Flag = "_theme",
		Callback = function(n)
			Library:SetTheme(n)
			win:Notify({ Title = "Тема", Text = n, Type = "info", Duration = 2 })
		end,
	})

	-- Игрок
	local tabP = win:CreateTab("Игрок")
	tabP:AddSectionInfo("Профиль", "Информация о тебе")
	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = Theme.Element, BackgroundTransparency = Theme.RowAlpha, BorderSizePixel = 0, Parent = tabP.Page,
	}, { corner(8) })
	local avatar = create("ImageLabel", {
		Size = UDim2.fromOffset(80, 80), Position = UDim2.fromOffset(16, 15),
		BackgroundColor3 = Theme.Hover, BorderSizePixel = 0, Parent = card,
	}, { round() })
	local function loadAvatar()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(LP.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		if ok then avatar.Image = url end
		return ok
	end
	task.spawn(loadAvatar)
	label(card, LP.DisplayName, UDim2.new(1, -120, 0, 26), UDim2.fromOffset(110, 16), 18).Font = Enum.Font.GothamBold
	label(card, "@" .. LP.Name, UDim2.new(1, -120, 0, 20), UDim2.fromOffset(110, 44), 14).TextColor3 = Theme.SubText
	label(card, "ID: " .. LP.UserId, UDim2.new(1, -120, 0, 20), UDim2.fromOffset(110, 66), 13).TextColor3 = Theme.SubText

	tabP:AddSectionInfo("Статистика", "Живые данные")
	local statCard = create("Frame", {
		Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = Theme.Element, BackgroundTransparency = Theme.RowAlpha, BorderSizePixel = 0, Parent = tabP.Page,
	}, { corner(8) })
	local statLbl = label(statCard, "", UDim2.new(1, -32, 1, -24), UDim2.fromOffset(16, 12), 13)
	statLbl.TextWrapped = true; statLbl.TextYAlignment = Enum.TextYAlignment.Top; statLbl.TextColor3 = Theme.SubText
	statLbl.TextTruncate = Enum.TextTruncate.None
	task.spawn(function()
		while statCard.Parent do
			local char = LP.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local pos = hrp and hrp.Position or Vector3.zero
			local fps = math.floor(1 / RunService.RenderStepped:Wait())
			local ping = 0
			pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
			statLbl.Text = string.format(
				"HP: %d / %d\nПозиция: %.0f, %.0f, %.0f\nFPS: %d\nПинг: %d мс\nИгроков онлайн: %d",
				hum and hum.Health or 0, hum and hum.MaxHealth or 100, pos.X, pos.Y, pos.Z, fps, ping, #Players:GetPlayers())
			task.wait(1)
		end
	end)
	tabP:AddButton({ Name = "Обновить профиль", Callback = function()
		local ok = loadAvatar()
		win:Notify({ Title = ok and "Успех" or "Ошибка", Text = ok and "Профиль обновлён" or "Не удалось загрузить аватар",
			Type = ok and "success" or "error" })
	end })

	-- Конфиг
	win:AddConfigTab(win:CreateTab("Конфиг"))

	-- Инфо
	local tabA = win:CreateTab("Инфо")
	tabA:AddSectionInfo("GuiLib", "v" .. Library.Version)
	tabA:AddParagraph({
		Title = "О библиотеке",
		Content = "Минималистичная GUI-библиотека.\nЗаточена под телефон и ПК.\nСтиль: Delta Executor.",
	})
	tabA:AddSectionInfo("Настройки", "Дополнительно")
	tabA:AddToggle({ Name = "Watermark", Default = false, Callback = function(v) Library:SetWatermark(win, v) end })
	tabA:AddToggle({ Name = "Эффект касания", Default = false, Callback = function(v) win:SetClickFx({ Enabled = v }) end })
	tabA:AddButton({ Name = "Закрыть всё", Callback = function()
		win:Dialog({
			Title = "Закрыть всё?", Text = "Все окна GuiLib будут закрыты.",
			Buttons = {
				{ Text = "Отмена" },
				{ Text = "Закрыть", Primary = true, Callback = function() Library:CloseAll() end },
			},
		})
	end })
end

return Library
