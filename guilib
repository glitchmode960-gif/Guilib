		Size = UDim2.fromOffset(6, 2), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(24, 24),
		Rotation = 45, BackgroundColor3 = Theme.SubText, BorderSizePixel = 0, Parent = sbox,
	})
	local searchBox = create("TextBox", {
		Size = UDim2.new(1, -42, 1, 0), Position = UDim2.fromOffset(34, 0), BackgroundTransparency = 1,
		Text = "", PlaceholderText = "Search...", PlaceholderColor3 = Theme.SubText, TextColor3 = Theme.Text,
		Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
