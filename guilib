local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64decode(s)
	local lk = {}
	for i = 1, 64 do lk[string.byte(B64, i)] = i - 1 end
	local out, acc, bits, n = {}, 0, 0, 0
	for i = 1, #s do
		local v = lk[string.byte(s, i)]
		if v then
			acc = acc * 64 + v
			bits += 6
			if bits >= 8 then
				bits -= 8
				local p = 2 ^ bits
				n += 1
				out[n] = string.char(math.floor(acc / p) % 256)
				acc = acc % p
			end
		end
	end
	return table.concat(out)
end

local function customAsset(path)
	local gca = getcustomasset or getsynasset
	if typeof(gca) ~= "function" then return nil end
	local ok, res = pcall(gca, path)
	return ok and res or nil
end

-- возвращает (Image, ratio) или nil
local function resolveBackground(src)
	if src == false then return nil end
	if src == nil or src == true or src == "anime" then
		local e = Library.Backgrounds.anime
		if typeof(writefile) ~= "function" or typeof(isfile) ~= "function" then return nil end
		local ok = pcall(function()
			if not isfile(e.file) then writefile(e.file, b64decode(table.concat(e.data))) end
		end)
		if not ok then return nil end
		local asset = customAsset(e.file)
		return asset, asset and e.ratio or nil
	end
	local s = tostring(src)
	if s:match("^rbxasset") then return s, nil end
	if s:match("^%d+$") then return "rbxassetid://" .. s, nil end
	if s:match("^https?://") then
		if typeof(writefile) ~= "function" or typeof(isfile) ~= "function" then return nil end
		local sum = 0
		for i = 1, #s do sum = (sum * 31 + string.byte(s, i)) % 1000000007 end
		local file = "GuiLib_bg_url_" .. sum .. ".png"
		local ok = pcall(function()
			if not isfile(file) then writefile(file, game:HttpGet(s)) end
		end)
		if not ok then return nil end
		return customAsset(file), nil
	end
	if typeof(isfile) == "function" and isfile(s) then return customAsset(s), nil end
	return nil
end

