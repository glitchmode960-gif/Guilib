local THEMES = {
	Delta = { Accent = Color3.fromRGB(0, 170, 255) },
	Blue = { Accent = Color3.fromRGB(70, 120, 255) },
	Red = { Accent = Color3.fromRGB(235, 70, 90) },
	Green = { Accent = Color3.fromRGB(70, 200, 120) },
	Gold = { Accent = Color3.fromRGB(230, 180, 60) },
	Cyan = { Accent = Color3.fromRGB(60, 200, 230) },
	Pink = { Accent = Color3.fromRGB(255, 100, 200) },
	Orange = { Accent = Color3.fromRGB(255, 150, 60) },
	Purple = { Accent = Color3.fromRGB(140, 90, 255) },
	Lime = { Accent = Color3.fromRGB(170, 230, 60) },
	Rose = { Accent = Color3.fromRGB(255, 110, 150) },
	Mint = { Accent = Color3.fromRGB(60, 220, 180) },
	Violet = { Accent = Color3.fromRGB(180, 80, 255) },
	Dark = { Accent = Color3.fromRGB(150, 150, 160) },
}

function Library:SetTheme(name)
	local t = THEMES[name]; if not t then return end
	local oldAccent = Theme.Accent
	Theme.Accent = t.Accent
	for _, gui in ipairs(CoreGui:GetChildren()) do
		if gui.Name:sub(1, 7) == "GuiLib_" then
			for _, obj in ipairs(gui:GetDescendants()) do
				pcall(function()
					if obj:IsA("UIStroke") and obj.Color == oldAccent then obj.Color = t.Accent end
					if (obj:IsA("Frame") or obj:IsA("TextButton")) and obj.BackgroundColor3 == oldAccent then
						obj.BackgroundColor3 = t.Accent
					end
					if (obj:IsA("TextLabel") or obj:IsA("TextBox")) and obj.TextColor3 == oldAccent then
						obj.TextColor3 = t.Accent
					end
					if obj:IsA("UIGradient") then
						local cs = obj.Color
						if cs and cs.Keypoints then
							local kps = {}
							for _, kp in ipairs(cs.Keypoints) do
								local col = kp.Value
								if col == oldAccent then col = t.Accent end
								table.insert(kps, ColorSequenceKeypoint.new(kp.Time, col))
							end
							if #kps > 0 then obj.Color = ColorSequence.new(kps) end
						end
					end
				end)
			end
		end
	end
end

function Library:GetThemes()
	local l = {}; for k, _ in pairs(THEMES) do table.insert(l, k) end; table.sort(l); return l
end

function Library:CloseAll()
	for _, gui in ipairs(CoreGui:GetChildren()) do
		if gui.Name:sub(1, 7) == "GuiLib_" then gui:Destroy() end
	end
end

-- ============================================================
-- CLICK FX + TOAST + WATERMARK
-- ============================================================
function Window:SetClickFx(cfg)
	cfg = cfg or {}
	if not cfg.Enabled then return end
	local gui = create("ScreenGui", { Name = "GuiLib_ClickFX", ResetOnSpawn = false,
		IgnoreGuiInset = true, DisplayOrder = 100, Parent = self.Gui })
	local color = cfg.Color or Theme.Accent
	local size = cfg.Size or 80
	local dur = cfg.Duration or 0.65
	UIS.InputBegan:Connect(function(i)
		if not isPointer(i) then return end
		local pos = UIS:GetMouseLocation()
		if i.UserInputType == Enum.UserInputType.Touch then pos = Vector2.new(i.Position.X, i.Position.Y + 36) end
		local c = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, pos.X, 0, pos.Y),
			Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = gui }, { round() })
		local s = create("UIStroke", { Color = color, Thickness = 3, Transparency = 0.1, Parent = c })
		tween(c, dur, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
		tween(s, dur, { Transparency = 1, Thickness = 1 })
		task.delay(dur + 0.05, function() c:Destroy() end)
	end)
end

function Window:Toast(text, duration)
	duration = duration or 2
	local t = create("TextLabel", { Size = UDim2.new(0, 240, 0, 44), AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 20), BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0,
		Text = text, TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 14, Parent = self.Gui },
		{ round() })
	tween(t, 0.3, { Position = UDim2.new(0.5, 0, 1, -60) }, Enum.EasingStyle.Quint)
	task.delay(duration, function()
		tween(t, 0.25, { Position = UDim2.new(0.5, 0, 1, 20) }); task.wait(0.3); t:Destroy()
	end)
end

function Library:SetWatermark(win, visible)
	if win._wm and win._wm.Parent then win._wm:Destroy(); win._wm = nil end
	if not visible then return end
	local wm = create("TextLabel", {
		Size = UDim2.fromOffset(260, 32), Position = UDim2.new(1, -272, 0, 12),
		BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0,
		Text = "  ⚡ " .. Library.Brand .. "  |  " .. LP.Name,
		TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = win.Gui,
	}, { round() })
	win._wm = wm
end

function Window:AddConfigTab(tab)
	tab:AddSection("Конфиг")
	tab:AddTextbox({ Name = "Имя конфига", Default = self.ConfigName or "default",
		Placeholder = "my_config", Callback = function(n) self.ConfigName = n end })
	tab:AddButton({ Name = "💾 Сохранить", Callback = function()
		local ok = self:SaveConfig()
		self:Notify({ Title = ok and "Успех" or "Ошибка", Text = ok and "Конфиг сохранён" or "writefile недоступен",
			Type = ok and "success" or "error" })
	end })
	tab:AddButton({ Name = "📂 Загрузить", Callback = function()
		local ok = self:LoadConfig()
		self:Notify({ Title = ok and "Успех" or "Ошибка", Text = ok and "Конфиг загружен" or "Файл не найден",
			Type = ok and "success" or "error" })
	end })
end

-- ============================================================
-- AUTO TABS
-- ============================================================
function Library:AddAutoTabs(win)
	-- Темы
	local tabT = win:CreateTab("Темы")
	tabT:AddSectionInfo("Персонализация", "Выбери цвет акцента")
	tabT:AddDropdown({
		Name = "Акцент", Options = Library:GetThemes(), Default = "Delta",
		Callback = function(n)
			Library:SetTheme(n)
			win:Notify({ Title = "Тема", Text = n, Type = "info", Duration = 2 })
		end,
	})

	-- Игрок
	local tabP = win:CreateTab("Игрок")
	tabP:AddSectionInfo("Профиль", "Информация о тебе")
	local card = create("Frame", { Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0, Parent = tabP.Page }, { corner(12) })
	local avatar = create("ImageLabel", { Size = UDim2.fromOffset(80, 80), Position = UDim2.fromOffset(16, 15),
		BackgroundColor3 = Theme.Hover, BorderSizePixel = 0, Parent = card }, { round() })
	task.spawn(function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(LP.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		if ok then avatar.Image = url end
	end)
	local nLbl = label(card, LP.DisplayName, UDim2.new(1, -120, 0, 26), UDim2.fromOffset(110, 16), 18)
	nLbl.Font = Enum.Font.GothamBold
	local uLbl = label(card, "@" .. LP.Name, UDim2.new(1, -120, 0, 20), UDim2.fromOffset(110, 44), 14)
	uLbl.TextColor3 = Theme.SubText
	local idLbl = label(card, "ID: " .. LP.UserId, UDim2.new(1, -120, 0, 20), UDim2.fromOffset(110, 66), 13)
	idLbl.TextColor3 = Theme.SubText

	tabP:AddSectionInfo("Статистика", "Живые данные")
	local statCard = create("Frame", { Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0, Parent = tabP.Page }, { corner(12) })
	local statLbl = label(statCard, "", UDim2.new(1, -32, 1, -24), UDim2.fromOffset(16, 12), 13)
	statLbl.TextWrapped = true; statLbl.TextYAlignment = Enum.TextYAlignment.Top; statLbl.TextColor3 = Theme.SubText
	task.spawn(function()
		while statCard.Parent do
			local char = LP.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hp = hum and hum.Health or 0
			local maxhp = hum and hum.MaxHealth or 100
			local pos = hrp and hrp.Position or Vector3.new()
			local fps = math.floor(1 / RunService.RenderStepped:Wait())
			local ping = 0
			pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
			statLbl.Text = string.format(
				"HP: %d / %d\nПозиция: %.0f, %.0f, %.0f\nFPS: %d\nПинг: %d мс\nИгроков онлайн: %d",
				hp, maxhp, pos.X, pos.Y, pos.Z, fps, ping, #Players:GetPlayers())
			task.wait(1)
		end
	end)

	tabP:AddButton({ Name = "🔄 Обновить профиль", Callback = function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(LP.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		if ok then avatar.Image = url end
		win:Notify({ Title = "Успех", Text = "Профиль обновлён", Type = "success" })
	end })

	-- Инфо
	local tabA = win:CreateTab("Инфо")
	tabA:AddSectionInfo("GuiLib", "v" .. Library.Version)
	tabA:AddParagraph({ Title = "О библиотеке",
		Content = "Минималистичная GUI-библиотека.\nЗаточена под телефон и ПК.\nСтиль: Delta Executor." })
	tabA:AddSectionInfo("Настройки", "Дополнительно")
	tabA:AddToggle({ Name = "Watermark", Default = false,
		Callback = function(v) Library:SetWatermark(win, v) end })
	tabA:AddButton({ Name = "🗑 Закрыть всё", Callback = function() Library:CloseAll() end })
end

return Library