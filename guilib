----------------------------------------------------------------
-- Хелперы
----------------------------------------------------------------
local function create(c, p, ch)
	local i = Instance.new(c); local pa
	for k, v in pairs(p or {}) do if k == "Parent" then pa = v else i[k] = v end end
	for _, x in ipairs(ch or {}) do x.Parent = i end
	if pa then i.Parent = pa end
	return i
end

local function corner(r) return create("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function round() return create("UICorner", { CornerRadius = UDim.new(1, 0) }) end
local function pad(t, b, l, r)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, t), PaddingBottom = UDim.new(0, b),
		PaddingLeft = UDim.new(0, l), PaddingRight = UDim.new(0, r),
	})
end

local function tween(o, t, p, s, d)
	local tw = TweenService:Create(o, TweenInfo.new(t, s or Enum.EasingStyle.Quad, d or Enum.EasingDirection.Out), p)
	tw:Play(); return tw
end

local function safe(fn, ...)
	if type(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then warn("[GuiLib] " .. tostring(err)) end
end

local function isPointer(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

-- input.Position не включает GuiInset, а AbsolutePosition при IgnoreGuiInset=true включает
local function screenPos(i)
	return Vector2.new(i.Position.X, i.Position.Y + GuiService:GetGuiInset().Y)
end

local function kindColor(kind)
	kind = string.lower(tostring(kind or "info"))
	if kind == "success" then return Theme.Success end
	if kind == "error" then return Theme.Error end
	if kind == "warn" or kind == "warning" then return Theme.Warning end
	return Theme.Info
end

local function mountGui(g)
	local list = {}
	if typeof(gethui) == "function" then local ok, u = pcall(gethui); if ok and u then table.insert(list, u) end end
	table.insert(list, CoreGui)
	for _, t in ipairs(list) do if pcall(function() g.Parent = t end) and g.Parent == t then return end end
	g.Parent = LP:WaitForChild("PlayerGui")
end

local function label(pa, tx, sz, po, ts)
	return create("TextLabel", {
		Size = sz, Position = po, BackgroundTransparency = 1, Text = tx or "",
		TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = ts or 15,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = pa,
	})
end

local function stroke()
	return create("UIStroke", {
		Color = Theme.Stroke, Transparency = 0.72, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function newRow(pa, h)
	return create("Frame", {
		Size = UDim2.new(1, 0, 0, h or ROW), BackgroundColor3 = Theme.Element, BackgroundTransparency = Theme.RowAlpha,
		BorderSizePixel = 0, ClipsDescendants = true, Parent = pa,
	}, { corner(6), stroke() })
end

local function ripple(row, input)
	local x = input.Position.X - row.AbsolutePosition.X
	local c = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, x, 0, math.min(row.AbsoluteSize.Y, ROW) / 2),
		Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.88, BorderSizePixel = 0, ZIndex = 2, Parent = row,
	}, { round() })
	local d = math.max(row.AbsoluteSize.X, 80) * 1.6
	tween(c, 0.5, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 })
	task.delay(0.55, function() c:Destroy() end)
end

local function clickArea(row, h)
	local b = create("TextButton", {
		Size = h and UDim2.new(1, 0, 0, h) or UDim2.fromScale(1, 1),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = row,
	})
	b.InputBegan:Connect(function(i)
		if isPointer(i) then ripple(row, i); tween(row, 0.1, { BackgroundColor3 = Theme.Hover }) end
	end)
	b.InputEnded:Connect(function(i)
		if isPointer(i) then tween(row, 0.2, { BackgroundColor3 = Theme.Element }) end
	end)
	return b
end

local function encodeV(v)
	if typeof(v) == "Color3" then return { __t = "Color3", r = v.R, g = v.G, b = v.B } end
	if typeof(v) == "EnumItem" then return { __t = "Enum", name = v.Name } end
	if type(v) == "table" then local o = {}; for k, x in pairs(v) do o[k] = encodeV(x) end; return o end
	return v
end
local function decodeV(v)
	if type(v) == "table" then
		if v.__t == "Color3" then return Color3.new(v.r, v.g, v.b) end
		if v.__t == "Enum" then return Enum.KeyCode[v.name] or v.name end
		local o = {}; for k, x in pairs(v) do o[k] = decodeV(x) end; return o
	end
	return v
end

