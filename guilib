	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), Parent = rowB })

	local function close()
		closed = true
		Library:PlaySound("Close")
		tween(card, 0.15, { GroupTransparency = 1 })
		tween(scale, 0.15, { Scale = 0.9 })
		tween(overlay, 0.15, { BackgroundTransparency = 1 })
