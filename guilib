----------------------------------------------------------------
-- ФЛАГИ И КОНФИГИ
----------------------------------------------------------------
function Window:_setFlag(flag, value, silent)
	if not flag then return end
	self.Flags[flag] = value
	if self.AutoSave and not silent then
		self._saveToken = (self._saveToken or 0) + 1
		local token = self._saveToken
		task.delay(1, function()
			if token == self._saveToken and self.Gui.Parent then self:SaveConfig() end
		end)
	end
end

function Window:_register(flag, obj, value)
	if not flag then return end
	self.Flags[flag] = value
	self._setters[flag] = function(v, silent) if obj.Set then obj:Set(v, silent) end end
end

function Window:SaveConfig(name)
	if typeof(writefile) ~= "function" then return false end
	local ok, data = pcall(function() return HttpService:JSONEncode(encodeV(self.Flags)) end)
	if not ok then return false end
	return (pcall(function() writefile("GuiLib_" .. (name or self.ConfigName) .. ".json", data) end))
end

-- fire = false: применить значения без вызова колбэков (по умолчанию колбэки вызываются)
function Window:LoadConfig(name, fire)
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then return false end
	local file = "GuiLib_" .. (name or self.ConfigName) .. ".json"
	if not isfile(file) then return false end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
	if not ok or type(data) ~= "table" then return false end
	for flag, value in pairs(data) do
		local setter = self._setters[flag]
		if setter then pcall(setter, decodeV(value), fire == false) end
	end
	return true
end

function Window:ListConfigs()
	local out = {}
	if typeof(listfiles) ~= "function" then return out end
	local ok, files = pcall(listfiles, "")
	if not ok or type(files) ~= "table" then return out end
	for _, f in ipairs(files) do
		local n = tostring(f):match("GuiLib_(.+)%.json$")
		if n then table.insert(out, n) end
	end
	table.sort(out)
	return out
end

