local function encodeValue(v)
	if typeof(v) == "Color3" then
		return { __t = "Color3", r = v.R, g = v.G, b = v.B }
	end
	if typeof(v) == "EnumItem" then
		return { __t = "Enum", name = v.Name }
	end
	if type(v) == "table" then
		local out = {}
		for k, val in pairs(v) do out[k] = encodeValue(val) end
		return out
	end
	return v
end

local function decodeValue(v)
	if type(v) == "table" then
		if v.__t == "Color3" then
			return Color3.new(v.r, v.g, v.b)
		end
		if v.__t == "Enum" then
			return Enum.KeyCode[v.name] or v.name
		end
		local out = {}
		for k, val in pairs(v) do out[k] = decodeValue(val) end
		return out
	end
	return v
end

