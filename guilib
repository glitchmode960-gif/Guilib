		self.Pages.Size = UDim2.new(1, -w, 1, 0)
		self.Pages.Position = UDim2.fromOffset(w, 0)
	end)

	self.Main.GroupTransparency = 1; self.Scale.Scale = 0.95
	tween(self.Main, 0.25, { GroupTransparency = 0 })
	tween(self.Scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Quint)
	return self
end

function Window:SetMaximized(v)
	self.Maximized = v
	self.Minimized = false
	self._size = self._fullSize()
	tween(self.Main, 0.28, {
		Size = UDim2.fromOffset(self._size.X, self._size.Y), Position = UDim2.fromScale(0.5, 0.5),
	}, Enum.EasingStyle.Quint)
end

function Window:_connect(sig, fn) local c = sig:Connect(fn); table.insert(self._conns, c); return c end

function Window:_drag(handle, target, onTap, onDrop)
	local dragging, moved, ds, sp = false, false, nil, nil
	handle.InputBegan:Connect(function(i)
		if not isPointer(i) then return end
		dragging, moved = true, false; ds, sp = i.Position, target.Position
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then
				dragging = false
				if not moved and onTap then onTap() end
				if moved and onDrop then onDrop() end
			end
		end)
	end)
	self:_connect(UIS.InputChanged, function(i)
		if dragging and isMove(i) then
			local d = i.Position - ds
			if d.Magnitude > 6 then moved = true end
			if moved or not onTap then
				target.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
				if not onTap then moved = true end
			end
		end
	end)
end

function Window:SetOpen(v)
	self.Open = v
	if v then
		self.Main.Visible = true
		tween(self.Main, 0.22, { GroupTransparency = 0 })
		tween(self.Scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Quint)
	else
		tween(self.Main, 0.15, { GroupTransparency = 1 })
		tween(self.Scale, 0.15, { Scale = 0.95 })
		task.delay(0.16, function() if not self.Open then self.Main.Visible = false end end)
	end
end

function Window:SetMinimized(v)
	self.Minimized = v
	tween(self.Main, 0.25, { Size = UDim2.fromOffset(self._size.X, v and 48 or self._size.Y) }, Enum.EasingStyle.Quint)
end

function Window:Destroy()
	for i, w in ipairs(Library._windows) do if w == self then table.remove(Library._windows, i); break end end
	for _, c in ipairs(self._conns) do c:Disconnect() end
	table.clear(self._conns)
	self.Gui:Destroy()
end

function Window:SelectTab(tab)
	for _, t in ipairs(self._tabs) do
		local on = t == tab
		if on and not t.Container.Visible then
			t.Container.Position = UDim2.fromOffset(0, 14)
			tween(t.Container, 0.22, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
		end
		t.Container.Visible = on
		tween(t.Button, 0.18, {
			BackgroundTransparency = on and 0.5 or 1,
			TextColor3 = on and Theme.Text or Theme.SubText,
		})
		tween(t.Indicator, 0.18, { BackgroundTransparency = on and 0 or 1 })
		if t.Icon then tween(t.Icon, 0.18, { ImageColor3 = on and Theme.Accent or Theme.SubText }) end
	end
	self._current = tab
end

-- поиск по названиям вкладок и элементов
function Window:Search(query)
	query = string.lower(query or "")
	local first
	for _, t in ipairs(self._tabs) do
		local tabMatch = query == "" or string.find(string.lower(t.Name), query, 1, true) ~= nil
		local any = tabMatch
		for _, row in ipairs(t.Page:GetChildren()) do
			if row:IsA("GuiObject") then
				local match = tabMatch
				if not match then
					local l = row:IsA("TextLabel") and row or row:FindFirstChildWhichIsA("TextLabel", true)
					match = l ~= nil and string.find(string.lower(l.Text), query, 1, true) ~= nil
				end
				row.Visible = match
				if match then any = true end
			end
		end
		t.Button.Visible = any
		if any and not first then first = t end
	end
	if self._current and not self._current.Button.Visible and first then self:SelectTab(first) end
end

-- CreateTab(name, icon): icon — необязательный "rbxassetid://..."
function Window:CreateTab(name, icon)
	local padL = icon and 42 or 16
	local button = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = Theme.Hover, BackgroundTransparency = 1,
		BorderSizePixel = 0, Text = name, TextColor3 = Theme.SubText, Font = Enum.Font.GothamMedium,
		TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left,
		AutoButtonColor = false, LayoutOrder = #self._tabs, Parent = self._sbList,
	}, { corner(8), create("UIPadding", { PaddingLeft = UDim.new(0, padL), PaddingRight = UDim.new(0, 6) }) })

