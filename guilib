function Tab:AddKeybind(o)
	local win = self.Window
	local key = o.Default or Enum.KeyCode.RightShift
	local listening = false

	local row = newRow(self.Page)
	label(row, o.Name, UDim2.new(1, -110, 1, 0), UDim2.fromOffset(14, 0))

	local badge = create("TextButton", {
		Size = UDim2.fromOffset(90, 30),
		Position = UDim2.new(1, -104, 0.5, -15),
		BackgroundColor3 = Theme.Hover,
		BorderSizePixel = 0,
		Text = key.Name,
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		AutoButtonColor = false,
		Parent = row,
	}, { corner(8), stroke(Theme.Stroke, 0.5) })

	local obj = {}
	local function setLabel() badge.Text = listening and "..." or key.Name end

	badge.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		setLabel()
		local conn
		conn = UIS.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if input.KeyCode == Enum.KeyCode.Escape then
				listening = false; setLabel(); conn:Disconnect(); return
			end
			key = input.KeyCode
			listening = false
			setLabel()
			conn:Disconnect()
			if o.Flag then win.Flags[o.Flag] = key.Name end
			safe(o.Callback, key)
		end)
	end)

	win:_connect(UIS.InputBegan, function(input, processed)
		if processed then return end
		if input.KeyCode == key and o.Callback then safe(o.Callback, key) end
	end)

	function obj:Get() return key end
	function obj:Set(v, s) 
		key = typeof(v) == "string" and (Enum.KeyCode[v] or key) or v
		setLabel()
		if o.Flag then win.Flags[o.Flag] = key.Name end
	end
	win:_register(o.Flag, obj, key.Name)
	return obj
end

