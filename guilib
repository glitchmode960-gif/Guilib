	opts = opts or {}
	local self = setmetatable({}, Window)
	self._conns, self._tabs, self._setters = {}, {}, {}
	self.Flags = {}; self.Open = true; self.Minimized = false; self.Maximized = false
	self.ConfigName = opts.ConfigName or "default"
	self.AutoSave = opts.AutoSave or false
	self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift

	local title = opts.Title or "Window"
	local cam = workspace.CurrentCamera
	local function fullSize()
		local v = cam.ViewportSize
		if self.Maximized then return Vector2.new(v.X * 0.96, v.Y * 0.9) end
		return Vector2.new(math.min(640, v.X * 0.94), math.min(440, v.Y * 0.78))
	end
