-- CreateTab(name, icon): icon — "rbxassetid://..." / число (картинка) или короткий символ-глиф
function Window:CreateTab(name, icon)
	local padL = icon and 34 or 12
	local button = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Theme.Hover, BackgroundTransparency = 1,
		BorderSizePixel = 0, Text = name, TextColor3 = Theme.SubText, Font = Enum.Font.GothamMedium,
		TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left,
		AutoButtonColor = false, LayoutOrder = self:_nextOrder(), Parent = self._sbList,
	}, { corner(8), create("UIPadding", { PaddingLeft = UDim.new(0, padL), PaddingRight = UDim.new(0, 6) }) })
	fx(button, nil)

	local indicator = create("Frame", {
		Size = UDim2.fromOffset(3, 14), Position = UDim2.new(0, 3 - padL, 0.5, -7),
		BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = button,
	}, { round() })

	local iconObj, iconScale
	if icon then
		local holder = create("Frame", {
			Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 9 - padL, 0.5, -8),
			BackgroundTransparency = 1, Parent = button,
		})
		iconScale = create("UIScale", { Parent = holder })
		local s = tostring(icon)
		if s:match("^rbxassetid") or s:match("^%d+$") then
			iconObj = create("ImageLabel", {
