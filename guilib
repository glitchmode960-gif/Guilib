		local str = hexBox.Text:gsub("[^%x]", "")
		if #str == 6 then
			local c = Color3.fromRGB(tonumber(str:sub(1, 2), 16), tonumber(str:sub(3, 4), 16), tonumber(str:sub(5, 6), 16))
			h, s, v = Color3.toHSV(c)
			updateHueGradient(); apply()
		else
			hexBox.Text = "#" .. hex(color)
		end
