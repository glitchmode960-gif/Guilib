----------------------------------------------------------------
-- Геометрия окна: позиция, масштаб, развёрнутость сохраняются в файл
----------------------------------------------------------------
function Window:SaveGeometry()
	if not self.SaveGeometryEnabled or typeof(writefile) ~= "function" or not self.Gui.Parent then return false end
	local v = workspace.CurrentCamera.ViewportSize
	local m, f = self.Main, self.Fab
	local c = m.AbsolutePosition + m.AbsoluteSize / 2
	local data = {
		fx = c.X / v.X, fy = c.Y / v.Y, scale = self.UserScale, maximized = self.Maximized,
		fabx = f.AbsolutePosition.X / v.X, faby = f.AbsolutePosition.Y / v.Y,
		w = self._customSize and self._customSize.X or nil, h = self._customSize and self._customSize.Y or nil,
		prefs = Library:_getPrefs(),
	}
	return (pcall(function() writefile(self._geoFile, HttpService:JSONEncode(data)) end))
end

function Window:LoadGeometry()
	if not self.SaveGeometryEnabled or typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then return false end
	if not isfile(self._geoFile) then return false end
	local ok, d = pcall(function() return HttpService:JSONDecode(readfile(self._geoFile)) end)
	if not ok or type(d) ~= "table" then return false end
	if type(d.scale) == "number" then self.UserScale = math.clamp(d.scale, 0.6, 1.4) end
	if type(d.w) == "number" and type(d.h) == "number" then
		self._customSize = Vector2.new(d.w, d.h)
		self._size = self._fullSize()
		self.Main.Size = UDim2.fromOffset(self._size.X, self._size.Y)
	end
	if d.maximized == true then
		self.Maximized = true
		self._size = self._fullSize()
		self.Main.Size = UDim2.fromOffset(self._size.X, self._size.Y)
	end
	if type(d.fx) == "number" and type(d.fy) == "number" then
		self.Main.Position = UDim2.fromScale(math.clamp(d.fx, 0.05, 0.95), math.clamp(d.fy, 0.05, 0.95))
	end
	if type(d.fabx) == "number" and type(d.faby) == "number" then
		self.Fab.Position = UDim2.fromScale(math.clamp(d.fabx, 0, 0.95), math.clamp(d.faby, 0, 0.92))
	end
	Library:_applyPrefs(d.prefs)
	self.Main.BackgroundTransparency = Theme.GlassAlpha
	return true
end

function Window:_queueGeo()
	if not self.SaveGeometryEnabled then return end
	self._geoTok = (self._geoTok or 0) + 1
	local my = self._geoTok
	task.delay(0.8, function()
		if my == self._geoTok and self.Gui.Parent then self:SaveGeometry() end
	end)
end

function Window:SetScale(v)
	v = math.clamp(tonumber(v) or 1, 0.6, 1.4)
	self.UserScale = v
	tween(self.Scale, 0.2, { Scale = v })
	self:_queueGeo()
end

function Window:ResetGeometry()
	self.Maximized = false; self.Minimized = false; self.UserScale = 1; self._customSize = nil
	self._size = self._fullSize()
	tween(self.Main, 0.3, {
		Size = UDim2.fromOffset(self._size.X, self._size.Y), Position = UDim2.fromScale(0.5, 0.5),
	}, Enum.EasingStyle.Quint)
	tween(self.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Quint)
	tween(self.Fab, 0.3, { Position = UDim2.new(0, 16, 0.45, 0) }, Enum.EasingStyle.Quint)
	local setter = self._setters["_scale"]
	if setter then pcall(setter, 100, true) end
	self:_queueGeo()
end

function Window:SetMaximized(v)
	self.Maximized = v
	self.Minimized = false
	self._size = self._fullSize()
	tween(self.Main, 0.28, {
		Size = UDim2.fromOffset(self._size.X, self._size.Y), Position = UDim2.fromScale(0.5, 0.5),
	}, Enum.EasingStyle.Quint)
	self:_queueGeo()
end

-- "rainbow" — обводка непрерывно меняет цвет, "theme" — вернуть цвет темы
function Window:SetGlowMode(mode)
	self._glow = mode
	if self._glowConn then self._glowConn:Disconnect(); self._glowConn = nil end
	if mode == "rainbow" then
		local hue = 0
		self._glowConn = RunService.RenderStepped:Connect(function(dt)
			hue = (hue + dt * 0.12) % 1
			local c = Color3.fromHSV(hue, 0.7, 1)
			self.BorderStroke.Color = c
			self.HeaderLine.BackgroundColor3 = c
			self.FabStroke.Color = c
		end)
		table.insert(self._conns, self._glowConn)
	else
		self.BorderStroke.Color = Theme.Stroke
		self.HeaderLine.BackgroundColor3 = Theme.Stroke
		self.FabStroke.Color = Theme.Stroke
	end
end

function Window:_connect(sig, fn) local c = sig:Connect(fn); table.insert(self._conns, c); return c end

-- перетаскивание: allow(input) решает, можно ли начинать; onTap — если сдвига не было; onDrop — после сдвига
function Window:_drag(handle, target, onTap, onDrop, allow)
	local dragging, moved, ds, sp = false, false, nil, nil
	handle.InputBegan:Connect(function(i)
		if not isPointer(i) then return end
		if allow and not allow(i) then return end
		dragging, moved = true, false; ds, sp = i.Position, target.Position
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then
				dragging = false
				if not moved and onTap then onTap() end
				if moved and onDrop then onDrop() end
			end
		end)
	end)
	self:_connect(UIS.InputChanged, function(i)
		if dragging and isMove(i) then
			local d = i.Position - ds
			if d.Magnitude > 6 then moved = true end
			if moved then
				target.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
			end
		end
	end)
end

function Window:SetOpen(v)
	if self.Open == v then return end
	self.Open = v
	local base = self.UserScale
	if v then
		Library:PlaySound("Open")
		self.Main.Visible = true
		tween(self.Main, 0.22, { GroupTransparency = 0 })
		tween(self.Scale, 0.3, { Scale = base }, Enum.EasingStyle.Back)
	else
		Library:PlaySound("Close")
		tween(self.Main, 0.15, { GroupTransparency = 1 })
		tween(self.Scale, 0.15, { Scale = base * 0.92 })
		task.delay(0.16, function() if not self.Open then self.Main.Visible = false end end)
	end
end

function Window:SetMinimized(v)
	self.Minimized = v
	tween(self.Main, 0.25, { Size = UDim2.fromOffset(self._size.X, v and 40 or self._size.Y) }, Enum.EasingStyle.Quint)
end

function Window:SetTitle(text)
	if self.TitleLabel then self.TitleLabel.Text = tostring(text) end
end

function Window:Toggle() self:SetOpen(not self.Open) end

function Window:Destroy()
	pcall(function() self:SaveGeometry() end)
	for _, fn in ipairs(self._cleanups or {}) do pcall(fn) end
	hideTip()
	for i, w in ipairs(Library._windows) do if w == self then table.remove(Library._windows, i); break end end
	for _, c in ipairs(self._conns) do c:Disconnect() end
	table.clear(self._conns)
	self.Gui:Destroy()
	task.delay(1.5, function() if #Library._windows == 0 then destroySounds() end end)
end

function Window:_nextOrder()
	self._order = (self._order or 0) + 1
	return self._order
end

function Window:SelectTab(tab)
	for _, t in ipairs(self._tabs) do
		local on = t == tab
		if on and not t.Container.Visible then
			t.Container.Position = UDim2.fromOffset(0, 14)
			tween(t.Container, 0.22, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
		end
		t.Container.Visible = on
		t.Page.ScrollingEnabled = true
		tween(t.Button, 0.18, {
			BackgroundTransparency = on and 0.5 or 1,
			TextColor3 = on and Theme.Text or Theme.SubText,
		})
		tween(t.Indicator, 0.18, { BackgroundTransparency = on and 0 or 1 })
		if t.IconObj then
			local prop = t.IconObj:IsA("ImageLabel") and "ImageColor3" or "TextColor3"
			tween(t.IconObj, 0.18, { [prop] = on and Theme.Accent or Theme.SubText })
			if on and self._current ~= t then -- поп-баунс иконки при переключении
				t.IconScale.Scale = 0.5
				tween(t.IconScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end
	end
	self._current = tab
end

-- поиск по названиям вкладок и элементов
function Window:Search(query)
	query = string.lower(query or "")
	local first
	for _, t in ipairs(self._tabs) do
		local tabMatch = query == "" or string.find(string.lower(t.Name), query, 1, true) ~= nil
		local any = tabMatch
		for _, row in ipairs(t.Page:GetChildren()) do
			if row:IsA("GuiObject") then
				local match = tabMatch
				if not match then
					local l = row:IsA("TextLabel") and row or row:FindFirstChildWhichIsA("TextLabel", true)
					match = l ~= nil and string.find(string.lower(l.Text), query, 1, true) ~= nil
				end
				row.Visible = match
				if match then any = true end
			end
		end
		t.Button.Visible = any
		if any and not first then first = t end
	end
	for _, g in ipairs(self._groups) do
		local any = false
		for _, t in ipairs(g.Tabs) do if t.Button.Visible then any = true end end
		g.Header.Visible = any
	end
	if self._current and not self._current.Button.Visible and first then self:SelectTab(first) end
end

